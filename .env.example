# Copy to .env for local development, and add the same variables in your host's
# environment settings (Netlify: Site configuration > Environment variables).
# All of these are public values. Never put a secret or private API key here.

# Your live domain, including https://. Turns on canonical URLs, the sitemap and indexing.
PUBLIC_SITE_URL=

# The email address shown on the site.
PUBLIC_CONTACT_EMAIL=

# Booking page for discovery calls (Cal.com, Calendly, Google Calendar...). Optional.
PUBLIC_BOOKING_URL=

# Only if NOT using Netlify Forms: a form endpoint such as https://formspree.io/f/abcdwxyz
PUBLIC_FORM_ENDPOINT=
