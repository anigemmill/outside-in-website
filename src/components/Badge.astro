---
/**
 * Spinning sticker badge (as in the brand reference). It is a real link to the
 * contact page. The ring of text rotates slowly; reduced-motion keeps it still.
 */
interface Props { class?: string; text?: string; href?: string }
const { class: className = '', text = 'Let’s talk • Outside In • Let’s talk • Outside In • ', href = '/contact/' } = Astro.props;
// Scalloped edge: 18 bumps around a circle.
const n = 18, R = 92, r = 84;
let d = '';
for (let i = 0; i <= n * 2; i++) {
  const a = (Math.PI * i) / n - Math.PI / 2;
  const rad = i % 2 ? r : R;
  d += `${i ? 'L' : 'M'}${(100 + rad * Math.cos(a)).toFixed(2)},${(100 + rad * Math.sin(a)).toFixed(2)}`;
}
---
<a class:list={['badge', className]} href={href}>
  <span class="visually-hidden">Let’s talk</span>
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <defs><path id="badge-circle" d="M100,100 m-60,0 a60,60 0 1,1 120,0 a60,60 0 1,1 -120,0" /></defs>
    <path d={d + 'Z'} class="badge__edge" />
    <g class="badge__spin">
      <text class="badge__text"><textPath href="#badge-circle" textLength="370">{text}</textPath></text>
    </g>
    <g class="badge__core" transform="translate(100 100)">
      <path d="M-15,15 L15,-15 M-5,-15 L15,-15 L15,5" />
    </g>
  </svg>
</a>
<style>
  .badge { display: block; width: clamp(6rem, 9vw, 9rem); color: var(--ink); transition: transform 0.4s var(--ease-out-back); }
  .badge:hover, .badge:focus-visible { transform: scale(1.08) rotate(-8deg); }
  .badge svg { width: 100%; height: auto; overflow: visible; }
  .badge__edge { fill: var(--magenta); }
  .badge__text { font-family: var(--font-display); font-weight: 800; font-size: 19px; letter-spacing: 1px; text-transform: uppercase; fill: var(--ink); }
  .badge__spin { transform-origin: 100px 100px; animation: badge-spin 18s linear infinite; }
  .badge__core path { stroke: var(--ink); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; fill: none; transition: transform 0.35s var(--ease-out-back); }
  .badge:hover .badge__core path { transform: translate(3px, -3px); }
  @keyframes badge-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .badge__spin { animation: none; } }
</style>
