---
/**
 * Contact form (the blue panel on /contact/).
 *
 * Delivery:
 *  - Default: Netlify Forms. Netlify detects this form at build time (data-netlify),
 *    stores submissions and emails them once notifications are switched on.
 *  - Alternative: set PUBLIC_FORM_ENDPOINT (e.g. a Formspree URL) and it posts there.
 * The "What do you need?" chips are toggle buttons; their selection is sent in the
 * hidden `needs` field. Without JavaScript the chips are hidden and the form still
 * submits normally, landing on /contact/thanks/.
 */
import { site } from '../config/site';

const endpoint = site.formEndpoint;
const usesNetlify = !endpoint;
const needs = ['Brand', 'Website', 'Campaign', 'Marketing', 'AI & automation', 'Findable', 'Not sure yet'];
---
<form
  class="cform"
  name="contact"
  method="POST"
  action={endpoint || '/contact/thanks/'}
  data-contact-form
  data-endpoint={endpoint || undefined}
  novalidate
  aria-labelledby="cform-title"
  {...(usesNetlify ? { 'data-netlify': 'true', 'netlify-honeypot': 'company_website' } : {})}
>
  <h2 id="cform-title" class="cform__title">Tell us a little</h2>
  {usesNetlify && <input type="hidden" name="form-name" value="contact" />}
  <input type="hidden" name="needs" value="" data-needs />
  <p class="cform__hp" aria-hidden="true">
    <label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="cform__chips" role="group" aria-labelledby="cf-needs-label" data-chips hidden>
    <p id="cf-needs-label" class="cform__legend">What do you need? <span class="opt">(choose any)</span></p>
    <div class="cform__chip-row">
      {needs.map((n) => <button type="button" class="chip" aria-pressed="false" data-need={n}>{n}</button>)}
    </div>
  </div>

  <div class="cform__row">
    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="cf-name-err" />
      <p class="field__err" id="cf-name-err" data-err-for="name"></p>
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="cf-email-err" />
      <p class="field__err" id="cf-email-err" data-err-for="email"></p>
    </div>
  </div>

  <div class="field">
    <label for="cf-company">Business <span class="opt">(optional)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="160" />
  </div>

  <div class="field">
    <label for="cf-message">What’s the idea?</label>
    <textarea id="cf-message" name="message" rows="5" required minlength="10" maxlength="4000" aria-describedby="cf-message-err"></textarea>
    <p class="field__err" id="cf-message-err" data-err-for="message"></p>
  </div>

  <p class="cform__privacy">We’ll only use these details to reply to you. See our <a href="/privacy/">privacy notice</a>.</p>

  <div class="cform__actions">
    <button class="pill pill--maroon pill--lg cform__submit" type="submit" data-submit>
      <span data-submit-label>Send it</span> <span class="arrow" aria-hidden="true">→</span>
    </button>
    <p class="cform__status" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<div class="cform-done" data-done hidden tabindex="-1">
  <p class="label label--strong">Sent</p>
  <p class="cform-done__title">Thanks. We’ve got it.</p>
  <p>We’ll reply to the email you gave us within {site.replyWithin}.</p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    const needsField = form.querySelector<HTMLInputElement>('[data-needs]')!;
    const chipGroup = form.querySelector<HTMLElement>('[data-chips]')!;
    const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-need]')];
    const endpoint = form.dataset.endpoint;

    // Toggle chips → the hidden `needs` field.
    chipGroup.hidden = false;
    const syncNeeds = () => {
      needsField.value = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.need).join(', ');
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
      syncNeeds();
    }));
    // ?need=Findable preselects a chip (e.g. from the Findable pages).
    const pre = new URL(location.href).searchParams.get('need')?.toLowerCase();
    if (pre) chips.forEach((c) => { if (c.dataset.need!.toLowerCase() === pre) c.setAttribute('aria-pressed', 'true'); });
    syncNeeds();

    const messages: Record<string, (el: HTMLInputElement) => string> = {
      name: () => 'Please tell us your name.',
      email: (el) => (el.validity.valueMissing ? 'Please add your email so we can reply.' : 'That email address doesn’t look quite right.'),
      message: (el) => (el.validity.valueMissing ? 'Please tell us a little about the idea.' : 'A little more detail would help (at least 10 characters).'),
    };

    const check = (el: HTMLInputElement) => {
      const err = form.querySelector<HTMLElement>(`[data-err-for="${el.name}"]`);
      if (!err) return true;
      const ok = el.checkValidity();
      el.setAttribute('aria-invalid', String(!ok));
      err.textContent = ok ? '' : messages[el.name]?.(el) ?? 'Please check this field.';
      return ok;
    };

    const fields = [...form.querySelectorAll<HTMLInputElement>('input[required], textarea[required]')];
    // Errors appear on submit and clear as each field is fixed.
    fields.forEach((el) => el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') check(el); }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = fields.filter((el) => !check(el));
      if (invalid.length) {
        status.textContent = `Please fix ${invalid.length} field${invalid.length > 1 ? 's' : ''} above.`;
        invalid[0].focus();
        return;
      }
      submit.disabled = true;
      label.textContent = 'Sending…';
      status.textContent = '';
      try {
        syncNeeds();
        const data = new FormData(form);
        if (data.get('company_website')) { form.hidden = true; done.hidden = false; return; } // bot trap
        const res = endpoint
          ? await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } })
          : await fetch('/', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
            });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        status.textContent = '';
        const msg = document.createElement('span');
        msg.className = 'cform__error';
        const email = document.querySelector<HTMLAnchorElement>('[data-contact-email]');
        msg.append('Sorry, that didn’t send. Please try again, or email us directly');
        if (email) {
          const a = document.createElement('a');
          a.href = email.href;
          a.textContent = email.textContent;
          msg.append(' at ', a);
        }
        msg.append('.');
        status.appendChild(msg);
      } finally {
        submit.disabled = false;
        label.textContent = 'Send it';
      }
    });
  }
</script>

<style>
  .cform { display: flex; flex-direction: column; gap: 28px; }
  .cform[hidden] { display: none; }
  .cform__title { font-weight: 500; font-size: clamp(30px, 3vw, 42px); letter-spacing: -0.03em; line-height: 1; }
  .cform__hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .cform__chips[hidden] { display: none; }
  .cform__legend { font-weight: 600; font-size: 15px; margin-bottom: 12px; }
  .cform__chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .cform .chip[aria-pressed='true'] { background: var(--pink); }
  .cform .chip[aria-pressed='true']::before { content: '✓ '; }
  .cform__row { display: flex; flex-wrap: wrap; gap: 16px; }
  .cform__row .field { flex: 1 1 220px; }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field label { font-weight: 600; font-size: 15px; }
  .opt { font-weight: 400; color: var(--brown-soft); }
  .field input, .field textarea {
    font: inherit; font-size: 17px; color: var(--brown); background: var(--cream);
    border: 1.5px solid var(--brown); border-radius: 0; min-height: 52px; padding: 0 16px; width: 100%;
  }
  .field textarea { padding: 14px 16px; resize: vertical; min-height: 9rem; }
  .field input:focus-visible, .field textarea:focus-visible { outline: 3px solid var(--maroon); outline-offset: 2px; }
  .field [aria-invalid='true'] { border-color: var(--maroon); box-shadow: inset 0 0 0 1px var(--maroon); }
  .field__err { font-size: 14px; color: var(--maroon); font-weight: 600; }
  .field__err:empty { display: none; }
  .cform__privacy { font-size: 14px; color: var(--brown-soft); }
  .cform__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .cform__submit[disabled] { opacity: 0.7; cursor: progress; }
  .cform__status { font-size: 14px; }
  .cform__status :global(.cform__error) { color: var(--maroon); font-weight: 600; }
  .cform-done { display: flex; flex-direction: column; gap: 12px; }
  .cform-done[hidden] { display: none; }
  .cform-done:focus { outline: none; }
  .cform-done__title { font-weight: 500; font-size: clamp(30px, 3vw, 42px); letter-spacing: -0.03em; line-height: 1.05; }
</style>
