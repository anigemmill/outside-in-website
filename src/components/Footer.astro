---
/**
 * Maroon footer. With `cta` it opens with the "Got an idea? Let's make it real."
 * band, as on Home and Services; pass your own content in the `cta` slot to
 * replace that band (About). Without either, it's the slim footer row only.
 */
import BookCall from './BookCall.astro';
import { site, nav } from '../config/site';

interface Props { cta?: boolean }
const { cta = false } = Astro.props;
const hasSlot = Astro.slots.has('cta');
const year = new Date().getFullYear();
const links = [...nav, ...(site.social.instagram ? [{ label: 'Instagram', href: site.social.instagram, external: true }] : []), ...(site.social.linkedin ? [{ label: 'LinkedIn', href: site.social.linkedin, external: true }] : [])] as { label: string; href: string; external?: boolean }[];
---
<footer class:list={['foot', 'on-maroon', { 'foot--cta': cta || hasSlot }]}>
  <div class="wrap foot__in">
    {hasSlot ? <div class="foot__cta"><slot name="cta" /></div> : cta && (
      <div class="foot__cta">
        <h2 class="foot__title">Got an idea?<br /><em class="em">Let’s make it real.</em></h2>
        <div class="foot__actions">
          <BookCall />
          <a class="foot__email" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    )}
    <div class="foot__row">
      <ul role="list" class="foot__links">
        {links.map((l) => (
          <li><a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}{l.external && <span aria-hidden="true"> ↗</span>}{l.external && <span class="visually-hidden"> (opens in a new tab)</span>}</a></li>
        ))}
      </ul>
      <p>{site.place} · © {year} {site.name} · <a href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>

<style>
  .foot { padding: 28px var(--gutter); }
  .foot--cta { padding-top: clamp(64px, 8vw, 128px); padding-bottom: 40px; }
  .foot__in { display: flex; flex-direction: column; gap: clamp(64px, 7vw, 96px); }
  .foot__cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 40px; }
  .foot__title { font-weight: 500; font-size: clamp(48px, 7vw, 104px); line-height: 0.92; letter-spacing: -0.05em; }
  .foot__title .em { letter-spacing: -0.02em; }
  .foot__actions { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .foot__email { font-size: 15px; color: var(--cream); overflow-wrap: anywhere; min-height: 44px; display: inline-flex; align-items: center; }
  .foot__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 20px; font-size: 13px; color: var(--cream); }
  .foot--cta .foot__row { border-top: 1px solid var(--pink); padding-top: 24px; }
  .foot__links { display: flex; flex-wrap: wrap; gap: 0 24px; }
  .foot__links a, .foot__row p a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
