---
import Logo from './Logo.astro';
import { nav, site, bookingHref, bookingIsExternal } from '../config/site';

const socials = Object.entries(site.social).filter(([, url]) => Boolean(url));
const labels: Record<string, string> = { instagram: 'Instagram', linkedin: 'LinkedIn', facebook: 'Facebook', behance: 'Behance' };
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <p class="site-footer__big">
        Too close to see it?<br /><span class="accent">Let’s look from outside.</span>
      </p>
      <div class="btn-row">
        <a class="btn btn--accent" href={bookingHref} {...(bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {})}>
          Book a discovery call <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost-inv" href="/contact/">Send an enquiry</a>
      </div>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo id="oi-foot" class="site-footer__mark" decorative />
        <p>Creative, marketing and AI.<br />Made in {site.location}.</p>
      </div>
      <nav aria-label="Footer">
        <p class="site-footer__h">Explore</p>
        <ul role="list">
          <li><a href="/">Home</a></li>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <p class="site-footer__h">Talk to us</p>
        <ul role="list">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={bookingHref} {...(bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {})}>Book a discovery call</a></li>
        </ul>
      </div>
      {socials.length > 0 && (
        <div>
          <p class="site-footer__h">Follow</p>
          <ul role="list">
            {socials.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener">{labels[k] ?? k}</a></li>)}
          </ul>
        </div>
      )}
    </div>

    <div class="site-footer__base">
      <p>© {year} {site.name}</p>
      <p><a href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink); color: var(--cream);
    padding-block: var(--section) 2rem;
    --line: rgba(250, 252, 240, 0.22); --fill: var(--lilac); --fill-fg: var(--ink); --fg: var(--cream); --bg: var(--ink);
  }
  :root[data-view='inside'] .site-footer { background: #000000; }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { color: var(--blush); }
  .site-footer__top { display: grid; gap: 2rem; padding-bottom: clamp(3rem, 6vw, 6rem); border-bottom: 1px solid var(--line); }
  .site-footer__big { font-family: var(--font-display); font-weight: 700; font-size: var(--step-4); line-height: 0.95; letter-spacing: -0.035em; font-weight: 800; text-transform: uppercase; }
  .accent { color: var(--blush); }
  .site-footer :global(.btn--accent) { --btn-bg: var(--magenta); --btn-fg: var(--ink); --fill: var(--lime); }
  .btn--ghost-inv { --btn-bg: transparent; --btn-fg: var(--cream); --btn-border: var(--cream); }
  .site-footer__grid {
    display: grid; gap: 2.5rem; padding-block: 3rem;
    grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr));
  }
  :global(.site-footer__mark) { width: 5.5rem; color: var(--cream); margin-bottom: 1rem; }
  .site-footer__brand p { color: var(--lilac); }
  .site-footer__h { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lilac); margin-bottom: 0.9rem; }
  .site-footer ul { display: grid; gap: 0.45rem; }
  .site-footer li a { display: inline-block; padding-block: 0.15rem; overflow-wrap: anywhere; }
  .site-footer__base {
    display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--lilac);
  }
  @media (max-width: 860px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
</style>
