---
import Logo from './Logo.astro';
import ViewToggle from './ViewToggle.astro';
import BookingLink from './BookingLink.astro';
import { nav, site } from '../config/site';

const socials = Object.entries(site.social).filter(([, url]) => Boolean(url));
const labels: Record<string, string> = { instagram: 'Instagram', linkedin: 'LinkedIn', facebook: 'Facebook', behance: 'Behance' };
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__cta">
      <p class="site-footer__big">Too close to see it?<br />Let’s look from outside.</p>
      <BookingLink class="btn btn--light" />
    </div>

    <div class="site-footer__grid">
      <Logo id="oi-foot" class="site-footer__mark" decorative />
      <nav aria-label="Footer">
        <ul role="list">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <ul role="list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {socials.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener">{labels[k] ?? k}</a></li>)}
        <li class="site-footer__loc">{site.location}</li>
      </ul>
      <div class="site-footer__toggle">
        <ViewToggle id="view-toggle-footer" />
        <p class="site-footer__hint">See the thinking behind every page.</p>
      </div>
    </div>

    <div class="site-footer__base">
      <p>© {year} {site.name}</p>
      <p><a href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink); color: var(--pink);
    padding-block: clamp(5rem, 10vw, 9rem) 2rem;
    --fg: var(--pink); --bg: var(--ink); --muted: var(--lilac); --accent: var(--green);
    --line: rgba(255, 153, 220, 0.2);
  }
  :root[data-view='inside'] .site-footer { background: #0e0b14; }
  .site-footer a { text-decoration: none; color: inherit; }
  .site-footer a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .site-footer__cta { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 2rem; padding-bottom: clamp(4rem, 8vw, 7rem); }
  .site-footer__big { font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 1.2rem + 3vw, 4rem); line-height: 1.05; letter-spacing: -0.03em; }
  :global(.btn--light) { --btn-bg: var(--pink); --btn-fg: var(--ink); --fill: var(--green); --fill-fg: var(--ink); }
  .site-footer__grid {
    display: grid; gap: 2.5rem; padding-block: 2.5rem; border-top: 1px solid var(--line);
    grid-template-columns: 1fr 1fr 1.3fr 1.2fr; align-items: start;
  }
  :global(.site-footer__mark) { width: 4.5rem; color: var(--pink); }
  .site-footer ul { display: grid; gap: 0.5rem; }
  .site-footer li a { display: inline-block; padding-block: 0.1rem; overflow-wrap: anywhere; }
  .site-footer__loc { color: var(--lilac); }
  .site-footer__toggle { display: grid; gap: 0.25rem; justify-items: start; }
  .site-footer__hint { font-size: var(--step--1); color: var(--lilac); }
  .site-footer__base { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--lilac); }
  @media (max-width: 860px) { .site-footer__grid { grid-template-columns: 1fr 1fr; } }
</style>
