---
import Logo from './Logo.astro';
import ViewToggle from './ViewToggle.astro';
import { nav, site, bookingHref, bookingIsExternal } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="site-header__inner wrap">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <Logo id="oi-head" animate="load" class="brand__mark" decorative />
      <span class="brand__word" aria-hidden="true">Outside&nbsp;In</span>
    </a>

    <div class="nav-pill">
      <nav class="site-nav" aria-label="Main">
        <ul role="list">
          {nav.filter((n) => n.href !== '/contact/').map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <ViewToggle id="view-toggle-desktop" class="hide-sm" />
    </div>

    <div class="site-header__actions">
      <a class="btn btn--talk hide-sm" href="/contact/">Let’s talk</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <span class="menu-btn__bars" aria-hidden="true"><span></span><span></span></span>
        <span class="menu-btn__label">Menu</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Mobile">
      <ul role="list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__foot">
      <ViewToggle id="view-toggle-mobile" />
      <a class="btn btn--accent" href={bookingHref} {...(bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {})}>
        Book a discovery call <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</header>

<style>
  /* Floating pills: the header itself is transparent. */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    padding-block: 0.75rem;
    pointer-events: none;
  }
  :global(.is-home) .site-header { position: fixed; left: 0; right: 0; }
  .site-header__inner { display: flex; align-items: center; gap: 0.75rem; }
  .site-header__inner > * { pointer-events: auto; }

  .brand {
    display: inline-flex; align-items: center; gap: 0.7rem; margin-right: auto;
    padding: 0.55rem 1.1rem 0.55rem 0.9rem; border-radius: var(--pill);
    background: var(--cream); color: var(--ink); text-decoration: none;
    box-shadow: 0 0 0 1.5px var(--ink);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out), visibility 0.4s;
  }
  /* On the homepage the hero is the logo, so the header mark waits until you scroll past it. */
  :global(.is-home) .site-header:not(.is-past-hero) .brand { opacity: 0; transform: translateY(-8px); visibility: hidden; }
  :global(.brand__mark) { width: 2.6rem; view-transition-name: oi-logo; }
  .brand__word { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .nav-pill {
    display: flex; align-items: center; gap: 1.25rem;
    padding: 0.3rem 0.5rem 0.3rem 1.4rem; border-radius: var(--pill);
    background: var(--ink); color: var(--cream);
    --fg: var(--cream); --muted: #b9b4bd; --accent: var(--lime);
  }
  :root[data-view='inside'] .nav-pill { background: var(--cream); color: var(--ink); --fg: var(--ink); --muted: var(--ink-soft); --accent: var(--magenta); }
  .site-nav ul { display: flex; gap: clamp(0.9rem, 1.6vw, 1.6rem); }
  .site-nav a { position: relative; display: inline-block; text-decoration: none; font-weight: 600; padding-block: 0.65rem; }
  .site-nav a::after {
    content: ''; position: absolute; left: 0; bottom: 0.35rem; height: 2px; width: 100%;
    background: var(--accent); transform: scaleX(0); transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .site-nav a:hover::after, .site-nav a[aria-current='page']::after { transform: scaleX(1); }

  .site-header__actions { display: flex; align-items: center; gap: 0.5rem; }
  .btn--talk { --btn-bg: var(--magenta); --btn-fg: var(--ink); --btn-border: var(--ink); --fill: var(--lime); --fill-fg: var(--ink); min-height: 2.9rem; padding-block: 0.6rem; }

  .menu-btn {
    display: none; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0 1.1rem;
    background: var(--ink); color: var(--cream); border: 0; border-radius: var(--pill);
    font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .menu-btn__bars { display: grid; gap: 6px; width: 22px; }
  .menu-btn__bars span { height: 2px; background: currentColor; transition: transform 0.35s var(--ease-out); }
  .menu-btn__bars span:last-child { width: 70%; transform: translateX(30%); }
  .menu-btn[aria-expanded='true'] .menu-btn__bars span:first-child { transform: translateY(4px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .menu-btn__bars span:last-child { width: 100%; transform: translateY(-4px) rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: 0; z-index: -1; pointer-events: auto;
    background: var(--blush); color: var(--ink); padding: 6rem var(--gutter) 2rem;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    overflow-y: auto; --fg: var(--ink); --muted: var(--ink-soft); --bg: var(--blush);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu ul { display: grid; gap: 0.2rem; }
  .mobile-menu li { animation: menu-in 0.5s var(--ease-out) both; animation-delay: calc(var(--i) * 50ms); }
  .mobile-menu nav a {
    display: block; font-family: var(--font-display); font-weight: 800; font-size: clamp(2.6rem, 12vw, 4rem);
    letter-spacing: -0.03em; line-height: 1.05; text-decoration: none; text-transform: uppercase;
  }
  .mobile-menu nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 6px; }
  .mobile-menu__foot { display: grid; gap: 1rem; justify-items: start; }
  @keyframes menu-in { from { opacity: 0; transform: translateX(-16px); } }

  @media (max-width: 960px) {
    .nav-pill { display: none; }
    .menu-btn { display: inline-flex; }
  }
</style>
