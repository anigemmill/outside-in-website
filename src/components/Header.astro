---
/**
 * Site navigation, in three looks from the mockups:
 *  - hero:  inside the homepage hero (no mark; the hero logo is the mark).
 *  - dark:  maroon band with a pink mark (Work and the case studies).
 *  - light: paper band with an orange mark (Services, About, Contact and the rest).
 * The links wrap on narrow screens instead of collapsing into a menu, as designed.
 */
import Logo from './Logo.astro';
import { nav } from '../config/site';

interface Props { look?: 'hero' | 'dark' | 'light' }
const { look = 'light' } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/' && path.startsWith(href);
const contact = nav.find((n) => n.href === '/contact/')!;
const links = nav.filter((n) => n !== contact);
const onContact = isCurrent(contact.href);
// In the hero the page's own <header> is the banner, so this is a plain wrapper.
const Tag = look === 'hero' ? 'div' : 'header';
---
<Tag class:list={['nav', `nav--${look}`]}>
  <nav aria-label="Main" class="nav__in">
    {look !== 'hero' && (
      <a href="/" class="nav__mark" aria-label="Outside In home">
        <Logo id="nav-mark" variant="nav" decorative />
      </a>
    )}
    <div class="nav__links">
      {links.map((l) => (
        <a class="nav__link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class:list={['pill', look === 'dark' ? 'pill--pink' : 'pill--maroon', 'nav__cta']} href={contact.href} aria-current={onContact ? 'page' : undefined}>
        Let’s talk{!onContact && <span class="arrow" aria-hidden="true"> →</span>}
      </a>
    </div>
  </nav>
</Tag>

<style>
  .nav__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; }
  .nav--dark, .nav--light { padding: 16px var(--gutter); }
  .nav--dark { background: var(--maroon); color: var(--pink); }
  .nav--light { background: var(--paper); color: var(--brown); border-bottom: 1px solid var(--line); }
  .nav__mark { display: inline-flex; align-items: center; min-height: 44px; }
  .nav__mark :global(.oi) { height: 36px; width: auto; }
  .nav--dark .nav__mark { color: var(--pink); }
  .nav--light .nav__mark { color: var(--orange); }
  .nav__links { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px; font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .nav__link { text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .nav__link[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  .nav--dark .nav__link[aria-current='page'] { color: var(--cream); }
  .nav--light .nav__link[aria-current='page'] { color: var(--maroon); }
  .nav__cta { letter-spacing: 0.02em; text-transform: none; }

  /* Inside the homepage hero. The hero background cycles through four colours,
     so the links sit on a cream pill to stay readable on every one of them. */
  .nav--hero .nav__in { justify-content: flex-end; }
  .nav--hero .nav__links { background: var(--cream); color: var(--brown); border-radius: 999px; padding: 4px 4px 4px 24px; gap: 4px 24px; }

  @media (max-width: 520px) {
    .nav__links { gap: 0 18px; font-size: 12px; }
    .nav--hero .nav__links { border-radius: 24px; padding: 4px 4px 4px 18px; }
  }
</style>
