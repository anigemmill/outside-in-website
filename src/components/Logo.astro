---
/**
 * The Outside In mark as live SVG.
 *
 * Geometry (unchanged from the supplied artwork, viewBox 110 128 887 522):
 *  - O: ring centred at 369.5,387, outer radius 259.5, inner radius 193.5.
 *  - I: bar 76 wide at x 842, from y 128 to 650.
 *  - One horizontal slice through each letter, shifted right:
 *    O band y 376 to 433, shift 73. I band y 377 to 437, shift 77.
 *
 * Each slice sits in an outer group translated to its real offset (so with no
 * CSS at all, or with reduced motion, it renders as the exact logo) and an
 * inner group that the animations move. Colour comes from currentColor;
 * `sliceFill` paints the slices separately (the About page mark).
 *
 * Variants:
 *  - static:  no motion.
 *  - hero:    entrance (halves drop and rise, slices fly in from the left with
 *             a slight overshoot), then the slices blink left and back every 1.5s.
 *  - nav:     the slices shift left while the parent link is hovered or focused.
 *  - sticker: a slower blink (every 2s), for the Work page sticker.
 *  - shift:   holds the slices shifted left, then back, every 4s (About).
 */
interface Props {
  id: string;
  variant?: 'static' | 'hero' | 'nav' | 'sticker' | 'shift';
  /** Accessible name. Omit (or pass decorative) when the mark is decorative. */
  label?: string;
  decorative?: boolean;
  sliceFill?: string;
  class?: string;
}
const { id, variant = 'static', label = 'Outside In', decorative = false, sliceFill, class: className } = Astro.props;

const cx = 369.5, cy = 387, R = 259.5, r = 193.5;
const ring = `M${cx - R},${cy}a${R},${R} 0 1,0 ${2 * R},0a${R},${R} 0 1,0 ${-2 * R},0Z` +
             `M${cx - r},${cy}a${r},${r} 0 1,0 ${2 * r},0a${r},${r} 0 1,0 ${-2 * r},0Z`;
---
<svg
  class:list={['oi', `oi--${variant}`, className]}
  viewBox="110 128 887 522"
  xmlns="http://www.w3.org/2000/svg"
  fill="currentColor"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  <defs>
    <clipPath id={`${id}-top`}><rect x="0" y="0" width="1200" height="376" /></clipPath>
    <clipPath id={`${id}-bot`}><rect x="0" y="433" width="1200" height="400" /></clipPath>
    <clipPath id={`${id}-band`}><rect x="0" y="376" width="1200" height="57" /></clipPath>
  </defs>
  <g class="oi-top">
    <path d={ring} fill-rule="evenodd" clip-path={`url(#${id}-top)`} />
    <rect x="842" y="128" width="76" height="249" />
  </g>
  <g class="oi-bot">
    <path d={ring} fill-rule="evenodd" clip-path={`url(#${id}-bot)`} />
    <rect x="842" y="437" width="76" height="213" />
  </g>
  <g class="oi-slice oi-slice--o" transform="translate(73,0)" style="--s: 73px">
    <g class="oi-move"><path d={ring} fill-rule="evenodd" clip-path={`url(#${id}-band)`} fill={sliceFill} /></g>
  </g>
  <g class="oi-slice oi-slice--i" transform="translate(77,0)" style="--s: 77px">
    <g class="oi-move"><rect x="842" y="377" width="77" height="60" fill={sliceFill} /></g>
  </g>
</svg>

<style is:global>
  .oi { display: block; width: 100%; height: auto; overflow: visible; }

  /* Hero: entrance, then the idle blink. */
  .oi--hero .oi-top { animation: oi-drop 0.75s var(--ease-out) 0.05s both; }
  .oi--hero .oi-bot { animation: oi-rise 0.75s var(--ease-out) 0.15s both; }
  .oi--hero .oi-slice--o { animation: oi-fly 0.9s var(--ease-out) 0.6s both; }
  .oi--hero .oi-slice--i { animation: oi-fly 0.9s var(--ease-out) 0.72s both; }
  /* Blinks with every second colour change of the hero (0.4s pairs). */
  .oi--hero .oi-move { animation: oi-blink 0.8s var(--ease-back) 1.6s infinite; }
  @keyframes oi-drop { from { transform: translateY(-140px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes oi-rise { from { transform: translateY(140px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes oi-fly {
    0% { transform: translateX(-520px); opacity: 0; }
    15% { opacity: 1; }
    70% { transform: translateX(calc(var(--s) + 18px)); }
    85% { transform: translateX(calc(var(--s) - 6px)); }
    100% { transform: translateX(var(--s)); opacity: 1; }
  }
  @keyframes oi-blink {
    0% { transform: translateX(0); }
    8% { transform: translateX(calc(var(--s) * -1)); }
    20%, 100% { transform: translateX(0); }
  }

  /* Nav mark: the slice shifts left on hover. */
  .oi--nav .oi-move { transition: transform 0.35s var(--ease-back); }
  a:hover > .oi--nav .oi-move,
  a:focus-visible > .oi--nav .oi-move { transform: translateX(calc(var(--s) * -1)); }

  /* Work page sticker */
  .oi--sticker .oi-move { animation: oi-blink 2s var(--ease-back) 1s infinite; }

  /* About: hold shifted, then return */
  .oi--shift .oi-move { animation: oi-shift 4s var(--ease-back) 1s infinite; }
  @keyframes oi-shift {
    0%, 30% { transform: translateX(0); }
    45%, 85% { transform: translateX(calc(var(--s) * -1)); }
    100% { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .oi .oi-top, .oi .oi-bot, .oi .oi-slice, .oi .oi-move { animation: none !important; transition: none !important; }
    .oi .oi-move { transform: none !important; }
  }
</style>
