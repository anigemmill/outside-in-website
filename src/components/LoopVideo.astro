---
/**
 * A short silent film that loops (e.g. an app launch film). It plays only while
 * on screen, never with reduced motion, and always has a visible pause/play
 * button, because looping motion longer than five seconds must be stoppable.
 * Without JavaScript the browser's own controls show instead.
 *
 * The Work page's "Pause motion" button also pauses every LoopVideo, through
 * the `oi:motion` event on document.
 *
 * If a .webm with the same name sits beside the .mp4 in public/, it's offered
 * too, for browsers without H.264.
 */
import fs from 'node:fs';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: string; poster: ImageMetadata; label: string; class?: string; fit?: 'cover' | 'contain' }
const { src, poster, label, class: className, fit = 'cover' } = Astro.props;
const webm = src.replace(/\.mp4$/, '.webm');
const hasWebm = webm !== src && fs.existsSync(`public${webm}`);
const posterImg = await getImage({ src: poster, width: Math.min(poster.width, 900), format: 'jpg' });
---
<div class:list={['lvid', className]} data-loop-video>
  <video poster={posterImg.src} muted loop playsinline preload="none" controls aria-label={label} style={`object-fit: ${fit}`}>
    <source src={src} type="video/mp4" />
    {hasWebm && <source src={webm} type="video/webm" />}
  </video>
  <button type="button" class="lvid__btn" data-loop-btn aria-pressed="false" hidden>
    <span class="lvid__ico" aria-hidden="true"></span><span data-loop-btn-label>Pause film</span>
  </button>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let globalPause = false;
  const players: Array<() => void> = [];

  document.querySelectorAll<HTMLElement>('[data-loop-video]').forEach((wrap) => {
    const video = wrap.querySelector('video')!;
    const btn = wrap.querySelector<HTMLButtonElement>('[data-loop-btn]')!;
    const btnLabel = btn.querySelector<HTMLElement>('[data-loop-btn-label]')!;
    video.controls = false;
    btn.hidden = false;
    // Paused by the viewer (this button), as opposed to scrolled out of view.
    let userPaused = reduce;
    let inView = false;

    const sync = () => {
      const play = inView && !userPaused && !globalPause;
      if (play && video.paused) {
        if (video.preload === 'none') video.preload = 'auto';
        video.play().catch(() => {});
      } else if (!play && !video.paused) video.pause();
      const playing = !userPaused && !globalPause;
      btn.setAttribute('aria-pressed', String(!playing));
      btnLabel.textContent = playing ? 'Pause film' : 'Play film';
    };
    players.push(sync);

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (globalPause) { globalPause = false; userPaused = false; }
      else userPaused = !userPaused;
      sync();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; sync(); }, { threshold: 0.25 }).observe(wrap);
    } else { inView = true; sync(); }
  });

  document.addEventListener('oi:motion', (e) => {
    globalPause = Boolean((e as CustomEvent<{ paused: boolean }>).detail?.paused);
    players.forEach((p) => p());
  });
</script>

<style>
  .lvid { position: relative; }
  .lvid video { display: block; width: 100%; height: 100%; }
  .lvid__btn {
    position: absolute; right: 14px; bottom: 14px; z-index: 2;
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 1rem;
    border: 0; border-radius: var(--pill); background: var(--white); color: var(--ink);
    font-size: 0.85rem; font-weight: 600; cursor: pointer;
  }
  .lvid__btn[hidden] { display: none; }
  .lvid__btn:hover { background: var(--ink); color: var(--white); }
  .lvid__btn:focus-visible { outline: 3px solid var(--white); outline-offset: 2px; }
  .lvid__ico { width: 10px; height: 11px; border-inline: 3px solid currentColor; }
  .lvid__btn[aria-pressed='true'] .lvid__ico { border: 0; width: 0; height: 0; border-left: 10px solid currentColor; border-block: 6px solid transparent; }
</style>
