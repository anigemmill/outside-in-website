---
/**
 * Findable pilot registration (Netlify Forms, form name "findable-pilot").
 *
 * Same pattern as ContactForm: Netlify detects the form at build time, stores
 * submissions and emails them once notifications are switched on (Netlify →
 * Forms → Form notifications). Spam trap: the hidden "company_website" field.
 * Without JavaScript the form submits normally and lands on /findable/thanks/.
 * Collects only what's needed to follow up about the pilot.
 */
const types = [
  'Accommodation',
  'Activity or attraction',
  'Tour operator',
  'Food and drink',
  'Transport',
  'Other',
];
---
<form
  class="pform"
  name="findable-pilot"
  method="POST"
  action="/findable/thanks/"
  data-pilot-form
  novalidate
  data-netlify="true"
  netlify-honeypot="company_website"
>
  <input type="hidden" name="form-name" value="findable-pilot" />
  <p class="pform__hp" aria-hidden="true">
    <label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="pform__row">
    <div class="field">
      <label for="pf-name">Your name <span class="req" aria-hidden="true">*</span></label>
      <input id="pf-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="pf-name-err" />
      <p class="field__err" id="pf-name-err" data-err-for="name"></p>
    </div>
    <div class="field">
      <label for="pf-email">Email <span class="req" aria-hidden="true">*</span></label>
      <input id="pf-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="pf-email-err" />
      <p class="field__err" id="pf-email-err" data-err-for="email"></p>
    </div>
  </div>

  <div class="pform__row">
    <div class="field">
      <label for="pf-business">Business name <span class="req" aria-hidden="true">*</span></label>
      <input id="pf-business" name="business" type="text" autocomplete="organization" required maxlength="160" aria-describedby="pf-business-err" />
      <p class="field__err" id="pf-business-err" data-err-for="business"></p>
    </div>
    <div class="field">
      <label for="pf-type">Type of business <span class="req" aria-hidden="true">*</span></label>
      <select id="pf-type" name="business_type" required aria-describedby="pf-type-err">
        <option value="">Choose one</option>
        {types.map((t) => <option value={t}>{t}</option>)}
      </select>
      <p class="field__err" id="pf-type-err" data-err-for="business_type"></p>
    </div>
  </div>

  <div class="pform__row">
    <div class="field">
      <label for="pf-location">Town or region <span class="opt">(optional)</span></label>
      <input id="pf-location" name="location" type="text" autocomplete="address-level2" maxlength="120" />
    </div>
    <div class="field">
      <label for="pf-website">Website <span class="opt">(optional)</span></label>
      <input id="pf-website" name="website" type="url" inputmode="url" autocomplete="url" maxlength="300" placeholder="https://" aria-describedby="pf-website-err" />
      <p class="field__err" id="pf-website-err" data-err-for="website"></p>
    </div>
  </div>

  <div class="field">
    <label for="pf-notes">Anything you’d like us to know? <span class="opt">(optional)</span></label>
    <textarea id="pf-notes" name="notes" rows="4" maxlength="2000"></textarea>
  </div>

  <div class="field field--check">
    <input id="pf-consent" name="consent" type="checkbox" value="yes" required aria-describedby="pf-consent-err" />
    <label for="pf-consent">I’m happy for Outside In to contact me about the Findable pilot. <span class="req" aria-hidden="true">*</span></label>
    <p class="field__err" id="pf-consent-err" data-err-for="consent"></p>
  </div>

  <p class="pform__privacy">
    We’ll only use these details to talk to you about the pilot. Registering doesn’t commit you to anything. See our <a class="text-link" href="/privacy/">privacy notice</a>.
  </p>

  <div class="pform__actions">
    <button class="btn btn--accent" type="submit" data-submit>
      <span data-submit-label>Register interest</span> <span class="btn__arrow" aria-hidden="true">→</span>
    </button>
    <p class="pform__status" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<div class="pform-done" data-done hidden tabindex="-1">
  <p class="eyebrow">Registered</p>
  <p class="pform-done__title">Thanks. You’re on the list.</p>
  <p class="lede">We’ll be in touch by email to talk about the pilot and whether it’s a good fit for your business.</p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-pilot-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const done = document.querySelector<HTMLElement>('[data-done]')!;

    const messages: Record<string, (el: HTMLInputElement) => string> = {
      name: () => 'Please tell us your name.',
      email: (el) => (el.validity.valueMissing ? 'Please add your email so we can get in touch.' : 'That email address doesn’t look quite right.'),
      business: () => 'Please add your business name.',
      business_type: () => 'Please choose the closest type of business.',
      website: () => 'Please enter a full web address, starting with https://',
      consent: () => 'Please tick this so we can contact you about the pilot.',
    };

    const check = (el: HTMLInputElement) => {
      const err = form.querySelector<HTMLElement>(`[data-err-for="${el.name}"]`);
      if (!err) return true;
      const ok = el.checkValidity();
      el.setAttribute('aria-invalid', String(!ok));
      err.textContent = ok ? '' : messages[el.name]?.(el) ?? 'Please check this field.';
      return ok;
    };

    const fields = [...form.querySelectorAll<HTMLInputElement>('input[required], select[required], textarea[required], input[type="url"]')];
    // Errors appear on submit and clear as the field is fixed. (Checking on blur
    // would insert a message mid-click and shift the form under the pointer.)
    fields.forEach((el) => {
      const recheck = () => { if (el.getAttribute('aria-invalid') === 'true') check(el); };
      el.addEventListener('input', recheck);
      el.addEventListener('change', recheck);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = fields.filter((el) => !check(el));
      if (invalid.length) {
        status.textContent = `Please fix ${invalid.length} field${invalid.length > 1 ? 's' : ''} above.`;
        invalid[0].focus();
        return;
      }
      submit.disabled = true;
      label.textContent = 'Sending…';
      status.textContent = '';
      try {
        const data = new FormData(form);
        if (data.get('company_website')) { form.hidden = true; done.hidden = false; return; } // bot trap
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        status.innerHTML = '';
        const msg = document.createElement('span');
        msg.className = 'pform__error';
        const email = document.querySelector<HTMLAnchorElement>('[data-contact-email]');
        msg.innerHTML = `Sorry, that didn’t send. Please try again, or email us${email ? ` at <a class="text-link" href="${email.href}">${email.textContent}</a>` : ''}.`;
        status.appendChild(msg);
      } finally {
        submit.disabled = false;
        label.textContent = 'Register interest';
      }
    });
  }
</script>

<style>
  .pform { display: grid; gap: 1.25rem; }
  .pform__hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .pform__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 640px) { .pform__row { grid-template-columns: 1fr; } }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-weight: 600; }
  .req { color: var(--link); }
  .opt { font-weight: 400; color: var(--muted); }
  .field input:not([type='checkbox']), .field select, .field textarea {
    width: 100%; min-height: 3.1rem; padding: 0.75rem 0.9rem;
    background: color-mix(in srgb, var(--bg) 70%, #fff); color: var(--fg);
    border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent); border-radius: 12px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  :root[data-view='inside'] .field input:not([type='checkbox']), :root[data-view='inside'] .field select, :root[data-view='inside'] .field textarea { background: var(--ink); }
  .field textarea { resize: vertical; min-height: 7rem; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--fg); }
  .field input:not([type='checkbox']):focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: none; border-color: var(--fg); box-shadow: 0 0 0 4px var(--lilac); }
  .field [aria-invalid='true'] { border-color: #b3261e; box-shadow: 0 0 0 3px #b3261e22; }
  :root[data-view='inside'] .field [aria-invalid='true'] { border-color: #ff9b8a; }
  .field--check { grid-template-columns: auto 1fr; align-items: start; column-gap: 0.75rem; }
  .field--check input { width: 1.4rem; height: 1.4rem; margin-top: 0.15rem; accent-color: var(--ink); }
  :root[data-view='inside'] .field--check input { accent-color: var(--green); }
  .field--check label { font-weight: 500; }
  .field--check .field__err { grid-column: 2; }
  .field__err { font-size: var(--step--1); color: #b3261e; font-weight: 600; }
  :root[data-view='inside'] .field__err { color: #ffb4a6; }
  .field__err:empty { display: none; }
  .pform__privacy { font-size: var(--step--1); color: var(--muted); }
  .pform__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .pform__status { font-size: var(--step--1); }
  .pform__status :global(.pform__error) { color: #b3261e; font-weight: 600; }
  :root[data-view='inside'] .pform__status :global(.pform__error) { color: #ffb4a6; }
  .pform-done { display: grid; gap: 1rem; padding: clamp(1.75rem, 4vw, 3rem); border-radius: var(--radius); background: var(--green); color: var(--ink); }
  .pform-done[hidden] { display: none; }
  .pform-done .eyebrow { color: var(--ink); }
  .pform-done__title { font-family: var(--font-display); font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; }
  .pform-done:focus { outline: none; }
</style>
