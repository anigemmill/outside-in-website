---
/**
 * Project tile: a large image with just the title and type beneath it.
 * Used on the homepage and the Work page.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'work'>; headingLevel?: 'h2' | 'h3'; priority?: boolean; tall?: boolean }
const { project, headingLevel = 'h3', priority = false, tall = false } = Astro.props;
const d = project.data;
const H = headingLevel;
const imgOpts = d.cover.format === 'svg' ? {} : { widths: [640, 960, 1400], sizes: '(max-width: 760px) 100vw, 50vw' };
---
<article class:list={['tile', { 'tile--tall': tall }]} data-reveal data-categories={d.categories.join(' ')} data-status={d.status}>
  <a class="tile__link" href={`/projects/${project.id}/`}>
    <div class="tile__media" style={`view-transition-name: cover-${project.id}`}>
      <Image src={d.cover} alt="" {...imgOpts} loading={priority ? 'eager' : 'lazy'} class="tile__img" />
    </div>
    <div class="tile__meta">
      <H class="tile__title">{d.title}</H>
      <p class="tile__type">{d.status === 'concept' ? 'Concept · ' : ''}{d.type}</p>
    </div>
    <p class="tile__sum">{d.summary}</p>
  </a>
</article>

<style>
  .tile__link { display: grid; gap: 0.9rem; text-decoration: none; color: var(--fg); }
  .tile__media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--surface); }
  .tile--tall .tile__media { aspect-ratio: 4 / 5; }
  .tile__img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .tile__link:hover .tile__img, .tile__link:focus-visible .tile__img { transform: scale(1.04); }
  .tile__meta { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem 1rem; flex-wrap: wrap; margin-top: 0.3rem; }
  .tile__title { font-size: var(--step-1); font-weight: 600; letter-spacing: -0.01em; }
  .tile__link:hover .tile__title { color: var(--link); }
  .tile__type { color: var(--muted); font-size: var(--step--1); }
  .tile__sum { color: var(--muted); max-width: 44ch; }
</style>
