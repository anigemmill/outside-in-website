---
/**
 * Draggable pill stickers around the hero mark. Purely decorative (aria-hidden):
 * the same words appear in the services copy for screen-reader and keyboard users.
 * Edit the words, colours and positions here. x/y are percentages of the hero mark area.
 */
const stickers = [
  { text: 'Brand', x: 4, y: 6, r: -8, tone: 'lilac' },
  { text: 'Websites', x: 58, y: 0, r: 6, tone: 'plum' },
  { text: 'AI agents', x: 70, y: 74, r: -5, tone: 'lilac' },
  { text: 'Campaigns', x: 0, y: 78, r: 5, tone: 'sage' },
  { text: 'Automation', x: 34, y: 88, r: -3, tone: 'plum' },
  { text: 'Events', x: 82, y: 30, r: 10, tone: 'mauve' },
];
---
<div class="stickers" aria-hidden="true" data-stickers>
  {stickers.map((s, i) => (
    <span class={`sticker sticker--${s.tone}`} style={`--x:${s.x}%;--y:${s.y}%;--r:${s.r}deg;--i:${i}`} data-sticker>{s.text}</span>
  ))}
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-stickers]');
  if (wrap) {
    let z = 10;
    wrap.querySelectorAll<HTMLElement>('[data-sticker]').forEach((el) => {
      let startX = 0, startY = 0, dx = 0, dy = 0, baseX = 0, baseY = 0, dragging = false;
      el.addEventListener('pointerdown', (e) => {
        dragging = true; el.setPointerCapture(e.pointerId);
        startX = e.clientX; startY = e.clientY; baseX = dx; baseY = dy;
        el.classList.add('is-dragging'); el.style.zIndex = String(++z);
      });
      el.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const r = wrap.getBoundingClientRect(), b = el.getBoundingClientRect();
        // Keep stickers inside the hero area so none get lost off-screen.
        const nx = baseX + e.clientX - startX, ny = baseY + e.clientY - startY;
        const minX = dx - (b.left - r.left), maxX = dx + (r.right - b.right);
        const minY = dy - (b.top - r.top), maxY = dy + (r.bottom - b.bottom);
        dx = Math.min(maxX, Math.max(minX, nx)); dy = Math.min(maxY, Math.max(minY, ny));
        el.style.setProperty('--dx', `${dx}px`); el.style.setProperty('--dy', `${dy}px`);
        el.style.setProperty('--tilt', `${Math.max(-12, Math.min(12, (e.movementX || 0) * 1.5))}deg`);
      });
      const end = () => { dragging = false; el.classList.remove('is-dragging'); el.style.setProperty('--tilt', '0deg'); };
      el.addEventListener('pointerup', end); el.addEventListener('pointercancel', end);
    });
  }
</script>

<style>
  .stickers { position: absolute; inset: -4% -2%; pointer-events: none; }
  .sticker {
    position: absolute; left: var(--x); top: var(--y);
    padding: 0.55em 1.05em; border-radius: 999px;
    font-family: var(--font-display); font-weight: 700; font-size: clamp(0.9rem, 0.75rem + 0.6vw, 1.3rem); letter-spacing: -0.01em;
    white-space: nowrap; cursor: grab; user-select: none; touch-action: none; pointer-events: auto;
    transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(calc(var(--r) + var(--tilt, 0deg)));
    transition: transform 0.25s cubic-bezier(0.34, 1.4, 0.64, 1), box-shadow 0.25s;
    animation: sticker-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(1.5s + var(--i) * 0.09s);
  }
  .sticker:hover { box-shadow: 0 6px 0 rgba(46, 16, 37, 0.25); }
  .sticker.is-dragging { cursor: grabbing; transition: box-shadow 0.2s; box-shadow: 0 14px 24px rgba(46, 16, 37, 0.28); }
  .sticker--lilac { background: var(--lilac); color: var(--plum); }
  .sticker--plum { background: var(--plum); color: var(--mint); }
  .sticker--sage { background: var(--sage); color: var(--mint); }
  .sticker--mauve { background: var(--mauve); color: var(--mint); }
  :root[data-view='inside'] .sticker--plum { background: var(--mint); color: var(--plum); }
  @keyframes sticker-in { from { opacity: 0; scale: 0.3; } to { opacity: 1; scale: 1; } }
  @media (max-width: 860px) { .sticker:nth-child(n+5) { display: none; } }
  @media (prefers-reduced-motion: reduce) { .sticker { animation: none; transition: none; } }
</style>
