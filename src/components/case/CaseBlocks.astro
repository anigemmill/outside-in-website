---
/**
 * Free-form case-study sections (the `blocks` field in a project's index.md),
 * from Ani's "Ride Retreat: Brand & Website" design. Block types:
 * - row: label, a statement in display type, paragraphs.
 * - band: a full-width cream band with a big line, an icon strip and captions.
 * - identity: palette image, a type card (in the client's own fonts) and a colour card.
 * - website: page screens, a full homepage that scrolls inside its frame, stats and notes.
 * - outcome: statement, text, placeholders for figures still to come (previews
 *   only, never live) and the live-site link.
 * The client's colours (forest greens, cream) are theirs, so they stay as set
 * here in both the Outside and Inside views.
 */
import '@fontsource/poppins/700.css';
import '@fontsource/epilogue/400.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Data = CollectionEntry<'work'>['data'];
interface Props { blocks: Data['blocks']; link?: Data['link']; preview: boolean }
const { blocks, link, preview } = Astro.props;
const id = (label: string) => 'cb-' + label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
{blocks.map((b) => (
  b.type === 'row' ? (
    <section class="wrap cb-row" aria-labelledby={id(b.label)}>
      <h2 id={id(b.label)} class="label cb-label">{b.label}</h2>
      <div class="cb-stack">
        <p class="cb-statement">{b.statement}</p>
        {b.paragraphs.map((t) => <p class="cb-para">{t}</p>)}
      </div>
    </section>
  ) : b.type === 'band' ? (
    <section class="cb-band" aria-labelledby={id(b.label)}>
      <div class="wrap cb-band-in">
        <h2 id={id(b.label)} class="label cb-label">{b.label}</h2>
        <p class="cb-band-line display">{b.line}</p>
        <p class="cb-band-text">{b.text}</p>
        {b.image && <Image class="cb-icons" src={b.image.src} alt={b.image.alt} widths={[480, 960]} sizes="(max-width: 1180px) 100vw, 1100px" loading="lazy" />}
        {b.captions.length > 0 && <ul role="list" class="cb-captions">{b.captions.map((c) => <li>{c}</li>)}</ul>}
        {b.after && <p class="cb-band-after">{b.after}</p>}
      </div>
    </section>
  ) : b.type === 'identity' ? (
    <section class="wrap cb-identity" aria-labelledby={id(b.label)}>
      <div class="cb-row cb-row--head">
        <h2 id={id(b.label)} class="label cb-label">{b.label}</h2>
        <div class="cb-stack">
          <p class="cb-statement">{b.statement}</p>
          <p class="cb-para">{b.text}</p>
        </div>
      </div>
      <div class="cb-palette"><Image src={b.palette.src} alt={b.palette.alt} widths={[800, 1600]} sizes="(max-width: 1440px) 100vw, 1360px" loading="lazy" /></div>
      <div class="cb-cards">
        <div class="cb-type">
          <span class="label cb-card-label">Type</span>
          <div class="cb-type-samples">
            <div><span class="cb-aa cb-poppins" aria-hidden="true">Aa</span><span>{b.headlineFont}</span></div>
            <div><span class="cb-aa cb-epilogue" aria-hidden="true">Aa</span><span>{b.bodyFont}</span></div>
          </div>
          <p class="cb-poppins cb-type-sample">{b.sample}</p>
          <p class="cb-epilogue cb-type-sub">{b.sampleSub}</p>
        </div>
        <div class="cb-colour">
          <span class="label cb-card-label">Colour</span>
          <p class="cb-colour-text">{b.colour}</p>
          <p>{b.colourNames}</p>
        </div>
      </div>
    </section>
  ) : b.type === 'website' ? (
    <section class="cb-web" aria-labelledby={id(b.label)}>
      <div class="wrap">
        <div class="cb-row cb-row--head">
          <h2 id={id(b.label)} class="label cb-label">{b.label}</h2>
          <div class="cb-stack">
            <p class="cb-statement">{b.statement}</p>
            <p class="cb-para">{b.text}</p>
          </div>
        </div>
        <Image class="cb-pages" src={b.pages.src} alt={b.pages.alt} widths={[800, 1400, 2000]} sizes="(max-width: 1440px) 100vw, 1360px" loading="lazy" />
        <div class="cb-web-grid">
          <figure class="cb-shot">
            <div class="cb-scroll" tabindex="0" role="group" aria-label="Full Ride Retreat homepage. Hover, focus or scroll to see all of it.">
              <Image src={b.scroll.src} alt={b.scroll.alt} widths={[600, 900]} sizes="(max-width: 900px) 100vw, 45vw" loading="lazy" />
            </div>
            <figcaption class="label"><span class="cb-hint-hover">Hover to scroll the homepage</span><span class="cb-hint-touch">Scroll inside to see the whole homepage</span></figcaption>
          </figure>
          <div class="cb-web-copy">
            <p>{b.lead}</p>
            <ul role="list" class="cb-stats">{b.stats.map((s) => <li><span class="cb-stat-n">{s.n}</span><span>{s.text}</span></li>)}</ul>
            <p>{b.after}</p>
            <dl class="cb-meta">{b.meta.map((m) => <div><dt class="label">{m.label}</dt><dd>{m.text}</dd></div>)}</dl>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="wrap cb-row" aria-labelledby={id(b.label)}>
      <h2 id={id(b.label)} class="label cb-label">{b.label}</h2>
      <div class="cb-stack">
        <p class="cb-statement">{b.statement}</p>
        <p class="cb-para">{b.text}</p>
        {preview && b.todos.map((t) => <p class="cb-todo"><strong>Preview only, not on the live site:</strong>{' '}{t}</p>)}
        {link && (
          <a class="btn btn--accent" href={link.href} target="_blank" rel="noopener">{link.label} <span class="btn__arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
        )}
      </div>
    </section>
  )
))}

<style>
  .cb-row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 2rem 1.75rem; padding-block: clamp(5rem, 10vw, 8.75rem) clamp(4rem, 8vw, 7.5rem); }
  .cb-row--head { padding: 0; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .cb-label { font-size: 0.9rem; letter-spacing: 0.14em; }
  .cb-stack { display: grid; gap: 1.75rem; justify-items: start; min-width: 0; }
  .cb-statement { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.75rem, 1.1rem + 2vw, 2.75rem); line-height: 0.98; letter-spacing: -0.01em; text-wrap: balance; }
  .cb-para { font-size: 1.25rem; line-height: 1.6; color: var(--muted); max-width: 62ch; }
  .cb-todo { width: 100%; padding: 1.6rem 1.9rem; border: 1.5px dashed var(--muted); border-radius: 20px; color: var(--muted); font-size: 1.2rem; line-height: 1.5; }
  .cb-todo strong { color: var(--fg); }
  @media (max-width: 900px) { .cb-row { grid-template-columns: 1fr; } }

  /* The idea: Ride Retreat's own cream and forest. */
  .cb-band { background: #fdfae1; color: #26311a; }
  .cb-band-in { padding-block: clamp(4.5rem, 9vw, 7.5rem); }
  .cb-band .cb-label { margin-bottom: 2.5rem; }
  .cb-band-line { font-size: clamp(3rem, 1rem + 8vw, 8.5rem); line-height: 0.9; }
  .cb-band-text { margin-top: 2.5rem; font-size: 1.3rem; line-height: 1.55; max-width: 46ch; }
  .cb-band :global(.cb-icons) { display: block; width: 100%; max-width: 1100px; height: auto; margin: clamp(3rem, 6vw, 4.5rem) auto 0; }
  .cb-captions { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.75rem; max-width: 1100px; margin: 1.75rem auto 0; padding: 0; text-align: center; font-size: 1.05rem; line-height: 1.45; }
  .cb-band-after { margin-top: clamp(3rem, 6vw, 4.5rem); font-size: 1.2rem; line-height: 1.6; max-width: 48ch; }
  @media (max-width: 700px) { .cb-captions { grid-template-columns: 1fr 1fr; } }

  .cb-identity { padding-block: clamp(5rem, 10vw, 8.75rem) clamp(4rem, 8vw, 7.5rem); }
  .cb-palette { border-radius: 32px; overflow: hidden; background: #fcfae3; }
  .cb-palette :global(img) { display: block; width: 100%; height: auto; }
  .cb-cards { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 1.75rem; margin-top: 1.75rem; }
  .cb-type, .cb-colour { display: flex; flex-direction: column; gap: 1.75rem; padding: clamp(1.75rem, 3.5vw, 3rem); border-radius: 32px; }
  .cb-type { background: #26311a; color: #fdfae1; }
  .cb-type .cb-card-label { color: #fae793; }
  .cb-card-label { font-size: 0.8rem; letter-spacing: 0.12em; }
  .cb-type-samples { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 2.5rem; }
  .cb-type-samples > div { display: grid; gap: 0.6rem; }
  .cb-aa { font-size: clamp(4rem, 2.5rem + 4vw, 6rem); line-height: 1; }
  .cb-poppins { font-family: 'Poppins', sans-serif; font-weight: 700; }
  .cb-epilogue { font-family: 'Epilogue', sans-serif; font-weight: 400; }
  .cb-type-sample { font-size: clamp(1.4rem, 1rem + 1vw, 1.75rem); line-height: 1.2; }
  .cb-type-sub { margin-top: -1rem; font-size: 1.1rem; line-height: 1.6; color: #e7e9d8; }
  .cb-colour { justify-content: space-between; background: #97a960; color: #171b11; font-size: 1.05rem; line-height: 1.5; }
  .cb-colour-text { font-size: 1.25rem; line-height: 1.55; }
  @media (max-width: 900px) { .cb-cards { grid-template-columns: 1fr; } }

  /* Website: a pale grey stage, light in both views. */
  .cb-web { background: #f0f0ed; color: var(--ink); padding-block: clamp(4.5rem, 9vw, 7.5rem); --muted: var(--ink-soft); --fg: var(--ink); }
  .cb-web :global(.cb-pages) { display: block; width: 100%; height: auto; border-radius: 24px; }
  .cb-web-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem 1.75rem; align-items: start; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .cb-shot { margin: 0; display: grid; gap: 0.9rem; }
  .cb-shot figcaption { color: var(--ink-soft); }
  .cb-scroll { --frame: clamp(520px, 53vw, 760px); height: var(--frame); border-radius: 20px; overflow: hidden; background: #f0f0ed; box-shadow: 0 20px 50px rgb(23 19 31 / 0.14); }
  .cb-scroll :global(img) { display: block; width: 100%; height: auto; }
  .cb-scroll:focus-visible { outline: 3px solid var(--purple-ink); outline-offset: 4px; }
  .cb-hint-touch { display: none; }
  /* Hover (or keyboard focus) glides down the page; touch and reduced motion scroll it by hand. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cb-scroll :global(img) { transition: transform 9s cubic-bezier(0.45, 0, 0.55, 1); }
    .cb-scroll:is(:hover, :focus-visible) :global(img) { transform: translateY(calc(-100% + var(--frame))); }
  }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .cb-scroll { overflow-y: auto; overscroll-behavior: contain; }
    .cb-hint-hover { display: none; }
    .cb-hint-touch { display: inline; }
  }
  .cb-web-copy { display: grid; gap: 1.75rem; padding-top: 0.5rem; font-size: 1.25rem; line-height: 1.6; }
  .cb-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; padding: 0; }
  .cb-stats li { display: grid; gap: 0.6rem; align-content: start; padding: 1.4rem; border-radius: 20px; background: var(--white); font-size: 0.95rem; line-height: 1.4; }
  .cb-stat-n { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.25rem, 1.6rem + 1.4vw, 3rem); line-height: 0.9; }
  .cb-meta { display: grid; gap: 1.1rem; margin: 0; padding-top: 1.4rem; border-top: 1.5px solid var(--ink); font-size: 1.05rem; line-height: 1.5; }
  .cb-meta dt { color: var(--ink-soft); }
  .cb-meta dd { margin: 0.5rem 0 0; }
  @media (max-width: 900px) { .cb-web-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .cb-stats { grid-template-columns: 1fr; } }
</style>
