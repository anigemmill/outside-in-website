---
/**
 * Approach with a sticky stage image (homepage v3, section 6). The image on the
 * left is sticky; the stages from src/data/approach.ts sit on the right as
 * numbered rows. The current stage is at full strength, the others at 45%, and
 * the image crossfades (300ms) as each stage reaches the middle of the screen.
 * Phones: the image on top, stages below. Reduced motion: no crossfade; each
 * stage shows its own image inline. Behaviour: setupApproach() in home.ts.
 */
import { Image } from 'astro:assets';
import BookingLink from '../BookingLink.astro';
import Note from '../Note.astro';
import { stages } from '../../data/approach';
import { home } from '../../data/home';
import { asset } from '../../data/homeAssets';

const imgs = home.approach.images.map((id) => asset(id));
---
<section class="appr col" aria-labelledby="appr-title" data-approach>
  <div class="appr__head">
    <p class="label appr__label">{home.approach.label}</p>
    <h2 id="appr-title" class="appr__title">{home.approach.title}</h2>
  </div>
  <div class="appr__grid">
    <div class="appr__media" aria-hidden="true">
      <div class="appr__frame">
        {imgs.map((img, i) => (
          <Image src={img.src} alt="" widths={[480, 900]} sizes="(max-width: 760px) 100vw, 40vw" loading="lazy" class:list={['appr__img', { 'is-on': i === 0 }]} data-stage-img />
        ))}
      </div>
    </div>
    <ol role="list" class="appr__stages">
      {stages.map((s, i) => (
        <li class:list={['appr__stage', { 'is-on': i === 0 }]} data-stage>
          <Image src={imgs[i].src} alt={imgs[i].alt} widths={[480, 900]} sizes="100vw" loading="lazy" class="appr__inline" />
          <span class="appr__n display">{s.n}</span>
          <div class="appr__copy">
            <h3 class="appr__name">{s.name}</h3>
            <p>{s.text}</p>
            <p class="label appr__get">You get: {s.youGet}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="appr__cta"><BookingLink /></div>
  <Note>The image stays put while the stages scroll past, so each step gets a picture without the page getting longer.</Note>
</section>

<style>
  .appr__head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .appr__label { color: var(--muted); }
  .appr__title { font-size: var(--step-4); }
  .appr__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .appr__media { position: sticky; top: 7rem; }
  .appr__frame { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: var(--surface); }
  .appr :global(.appr__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.3s linear; }
  .appr :global(.appr__img.is-on) { opacity: 1; }
  .appr__stages { margin: 0; padding: 0; }
  .appr__stage { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1rem 1.5rem; padding-block: clamp(2.5rem, 7vh, 4.5rem); border-top: 1px solid var(--line); }
  .appr__stage:last-child { border-bottom: 1px solid var(--line); }
  .appr :global(.appr__inline) { display: none; }
  .appr__n { font-size: clamp(2rem, 1.4rem + 1.6vw, 3rem); color: var(--muted); }
  .appr__copy { display: grid; gap: 0.75rem; }
  .appr__name { font-size: var(--step-3); }
  .appr__get { color: var(--muted); }
  .appr__cta { margin-top: clamp(2rem, 5vw, 3.5rem); display: flex; justify-content: flex-end; }

  /* Live (script + motion): the current stage at full strength, the others
     dimmed. The spec asks for 45%; it's done with colour rather than opacity so
     dimmed text still passes contrast (large headings 3:1, body 4.5:1). */
  .appr:global(.is-live) .appr__stage :is(.appr__n, .appr__name, p) { transition: color 0.3s; }
  .appr:global(.is-live) .appr__stage:not(.is-on) :is(.appr__n, .appr__name) { color: var(--dim-lg, #8c8696); }
  .appr:global(.is-live) .appr__stage:not(.is-on) p { color: var(--dim, #6e6878); }
  :root[data-view='inside'] .appr { --dim-lg: #8c8696; --dim: #a9a3b4; }

  @media (max-width: 760px) {
    .appr__grid { grid-template-columns: 1fr; }
    .appr__media { position: relative; top: 0; }
    .appr__frame { aspect-ratio: 4 / 3; }
    .appr__stage { grid-template-columns: 3rem minmax(0, 1fr); }
    .appr__cta { justify-content: flex-start; }
  }
  /* Reduced motion: no crossfade; each stage carries its own image. */
  @media (prefers-reduced-motion: reduce) {
    .appr__media { display: none; }
    .appr__grid { grid-template-columns: 1fr; }
    .appr :global(.appr__inline) { display: block; grid-column: 1 / -1; width: min(100%, 26rem); aspect-ratio: 3 / 4; object-fit: cover; }
    .appr__stage { opacity: 1 !important; }
  }
</style>
