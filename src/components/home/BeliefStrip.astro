---
/**
 * 07 Colour card strip. Belief cards in the four palette colours, alternating with
 * images. Desktop: the row slides left as the section crosses the screen (not
 * pinned). Touch: a native horizontal scroller with snap points and dots.
 * Reduced motion: the cards wrap into a grid.
 */
import { Image } from 'astro:assets';
import Note from '../Note.astro';
import { home } from '../../data/home';
import { asset } from '../../data/homeAssets';

const colours = ['pink', 'green', 'purple', 'red'];
// Colour card, image, colour card, image, image, … (4 cards, 6 images)
const pattern = ['c', 'i', 'c', 'i', 'i', 'c', 'i', 'c', 'i', 'i'];
let c = 0, im = 0;
const items = pattern.map((t) =>
  t === 'c'
    ? { kind: 'card' as const, text: home.beliefs.cards[c], colour: colours[c++] }
    : { kind: 'image' as const, img: asset(`strip-0${++im}`) },
);
---
<section class="strip" aria-labelledby="strip-title" data-strip>
  <div class="wrap"><h2 id="strip-title" class="row-head__title strip__title">{home.beliefs.title}</h2></div>
  <div class="strip__viewport" data-strip-viewport>
    <ul role="list" class="strip__row scrub" data-strip-row>
      {items.map((it) =>
        it.kind === 'card' ? (
          <li class="strip__item strip__card" style={`--c: var(--${it.colour})`}><p>{it.text}</p></li>
        ) : (
          <li class="strip__item strip__image">
            <Image src={it.img.src} alt={it.img.alt} widths={[360, 720]} sizes="(max-width: 760px) 70vw, 22rem" loading="lazy" />
          </li>
        ),
      )}
    </ul>
  </div>
  <div class="strip__dots wrap" aria-hidden="true" data-strip-dots>
    {items.map(() => <span></span>)}
  </div>
  <div class="wrap"><Note>Beliefs are short and coloured so they read like a set. Ani writes these; until then they stay as placeholders.</Note></div>
</section>

<style>
  .strip { padding-bottom: clamp(6rem, 12vw, 12rem); overflow-x: clip; }
  .strip__title { margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  /* Reduced motion / no JavaScript: a wrapping grid */
  .strip__viewport { padding-inline: var(--gutter); max-width: var(--max); margin-inline: auto; }
  .strip__row { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 1rem; }
  .strip__item { aspect-ratio: 3 / 4; border-radius: 12px; overflow: hidden; }
  .strip__card { background: var(--c); color: var(--ink); padding: 1.4rem; display: flex; align-items: end; }
  .strip__card p { font-family: var(--font-display); font-weight: 600; font-size: var(--step-2); line-height: 1.05; letter-spacing: -0.02em; }
  .strip__image img { width: 100%; height: 100%; object-fit: cover; }
  .strip__dots { display: none; }

  /* Desktop (fine pointer): the row slides left as the section crosses the viewport. */
  .strip.is-live.strip--slide { --tl: --strip; --range: cover 15% cover 85%; view-timeline: --strip block; }
  .strip--slide .strip__viewport { max-width: none; overflow: visible; }
  .strip--slide .strip__row { display: flex; gap: 1rem; width: max-content; animation-name: strip-slide; will-change: transform; }
  .strip--slide .strip__item { width: clamp(15rem, 22vw, 22rem); flex: none; }
  @keyframes strip-slide { from { transform: translateX(0); } to { transform: translateX(calc(var(--overflow, 0px) * -1)); } }

  /* Touch: a native horizontal scroller with snap points and dots. The page itself
     never scrolls sideways (the section clips). */
  .strip--swipe .strip__viewport { max-width: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-padding-inline: var(--gutter); }
  .strip--swipe .strip__viewport::-webkit-scrollbar { display: none; }
  .strip--swipe .strip__row { display: flex; gap: 0.75rem; width: max-content; padding-right: var(--gutter); }
  .strip--swipe .strip__item { width: min(70vw, 18rem); flex: none; scroll-snap-align: start; }
  .strip--swipe .strip__dots { display: flex; gap: 0.4rem; justify-content: center; margin-top: 1.25rem; }
  .strip__dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--line); transition: background-color 0.2s; }
  .strip__dots span.is-on { background: var(--fg); }
</style>
