---
/**
 * 10 Corner-square call to action. An ink card in its own white section. Four
 * palette squares fly in from the corners, spin a quarter turn and lock half over
 * the card's corners. Hover or focus springs them out and nudges the arrow.
 * The whole card is one link (the Cal.com booking page).
 */
import { site, bookingHref, bookingIsExternal } from '../../config/site';
import { home } from '../../data/home';
import Note from '../Note.astro';
---
<section class="cta-sec col" aria-label="Get in touch" data-cta>
  <a class="cta" href={bookingHref} {...(bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {})}>
    <span class="cta__sq cta__sq--tl" aria-hidden="true"></span>
    <span class="cta__sq cta__sq--tr" aria-hidden="true"></span>
    <span class="cta__sq cta__sq--bl" aria-hidden="true"></span>
    <span class="cta__sq cta__sq--br" aria-hidden="true"></span>
    <span class="cta__line">{home.cta.line}</span>
    <span class="cta__foot">
      <span class="cta__email">{site.email}</span>
      <span class="cta__btn">{home.cta.button} <span class="cta__arrow" aria-hidden="true">→</span></span>
    </span>
    {bookingIsExternal && <span class="visually-hidden"> (books a discovery call, opens in a new tab)</span>}
  </a>
  <Note>One card, one action. The four squares are the four palette colours, holding the card like corner mounts.</Note>
</section>

<style>
  .cta-sec { padding-block: clamp(2rem, 4vw, 3rem); }
  .cta {
    --sq: clamp(2.25rem, 5vw, 3.5rem);
    position: relative; display: grid; gap: clamp(2rem, 5vw, 4rem); align-content: space-between;
    max-width: 60rem; margin-inline: auto; min-height: clamp(18rem, 36vw, 26rem);
    padding: clamp(2rem, 6vw, 4.5rem); background: var(--ink); color: var(--pink); border-radius: 4px;
    text-decoration: none;
  }
  .cta__line { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--step-4); line-height: 0.9; letter-spacing: -0.02em; max-width: 14ch; }
  .cta__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; }
  .cta__email { color: var(--lilac); overflow-wrap: anywhere; }
  .cta__btn { display: inline-flex; align-items: center; gap: 0.6em; background: var(--pink); color: var(--ink); font-weight: 600; padding: 0.85rem 1.5rem; border-radius: var(--pill); }
  .cta__arrow { display: inline-block; transition: transform 0.22s var(--ease-out-back); }
  .cta:hover .cta__arrow, .cta:focus-visible .cta__arrow { transform: translateX(5px); }
  .cta:focus-visible { outline-offset: 6px; }

  /* Squares: settled state, half over each corner. */
  .cta__sq { position: absolute; width: var(--sq); height: var(--sq); --dx: 0; --dy: 0; transition: transform 0.22s var(--ease-out-back); }
  .cta__sq--tl { top: 0; left: 0; translate: -50% -50%; background: var(--pink); --dx: -1; --dy: -1; }
  .cta__sq--tr { top: 0; right: 0; translate: 50% -50%; background: var(--green); --dx: 1; --dy: -1; }
  .cta__sq--bl { bottom: 0; left: 0; translate: -50% 50%; background: var(--purple); --dx: -1; --dy: 1; }
  .cta__sq--br { bottom: 0; right: 0; translate: 50% 50%; background: var(--red); --dx: 1; --dy: 1; }
  .cta:hover .cta__sq, .cta:focus-visible .cta__sq { transform: translate(calc(var(--dx) * 24px), calc(var(--dy) * 24px)); }

  /* Arrival (script + motion): from the section corners, a quarter turn, then lock. */
  /* The corner squares hang half outside the card: never let them widen a phone screen. */
  .cta-sec { overflow-x: clip; }
  .cta-sec.is-live { overflow: clip; }
  .cta-sec.is-live:not(.is-in) .cta__sq { opacity: 0; }
  .cta-sec.is-in .cta__sq { animation: cta-sq-in 0.7s cubic-bezier(0.34, 1.25, 0.64, 1) backwards; }
  .cta-sec.is-in .cta__sq--tr { animation-delay: 70ms; }
  .cta-sec.is-in .cta__sq--bl { animation-delay: 140ms; }
  .cta-sec.is-in .cta__sq--br { animation-delay: 210ms; }
  @keyframes cta-sq-in {
    from { opacity: 0; transform: translate(calc(var(--dx) * 22vw), calc(var(--dy) * 20vh)) rotate(-90deg); }
    30% { opacity: 1; }
    to { opacity: 1; transform: translate(0, 0) rotate(0deg); }
  }
  @media (max-width: 760px) { .cta__line { font-size: var(--step-3); } }
</style>
