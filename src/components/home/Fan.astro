---
/**
 * A fanned hand of cards (homepage effect 09). The cards start as a neat pile,
 * then deal out into a fan when the pile comes into view. Hover or focus lifts a
 * card, grows it and shows its caption; the neighbours lean away. Reduced motion:
 * already fanned, no lift. Behaviour lives in src/scripts/home.ts (setupFan).
 *
 * Cards with an href are links. On touch, the first tap brings a card to the
 * front and shows its caption; tapping the front card opens it.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface FanCard { src: ImageMetadata; label: string; sub?: string; href?: string }
interface Props {
  cards: FanCard[];
  /** Card height ÷ width: 16/9 for phone screens, 5/4 for portrait project cards. */
  ratio?: number;
  /** Card width (CSS length). */
  width?: string;
  sizes?: string;
}
const { cards, ratio = 16 / 9, width = 'clamp(8.5rem, 15vw, 13rem)', sizes = '(max-width: 760px) 34vw, 13rem' } = Astro.props;
const mid = (cards.length - 1) / 2;
---
<div class="fan" data-fan-deck style={`--n: ${cards.length}; --cw: ${width}; --ratio: ${ratio}`}>
  {cards.map((c, i) => {
    const Tag = c.href ? 'a' : 'button';
    const caption = c.sub ? `${c.label} · ${c.sub}` : c.label;
    return (
      <Tag
        {...(c.href ? { href: c.href } : { type: 'button' })}
        class="fan__card"
        style={`--i: ${i}; --o: ${i - mid}; --pile: ${((i * 37) % 7) - 3}`}
        data-fan-card
        data-caption={caption}
        aria-label={caption}
      >
        <Image src={c.src} alt="" widths={[320, 640]} sizes={sizes} loading="lazy" />
      </Tag>
    );
  })}
</div>
<p class="fan__caption" aria-hidden="true" data-fan-caption>&nbsp;</p>

<style>
  .fan { --spread: clamp(2.6rem, 9vw, 8.5rem); position: relative; height: calc(var(--cw) * var(--ratio) + 8rem); overflow: clip; overflow-clip-margin: 0px; }
  .fan__card {
    --lean: 0;
    position: absolute; left: 50%; top: 4rem; width: var(--cw); aspect-ratio: 1 / var(--ratio); margin-left: calc(var(--cw) / -2);
    display: block; padding: 0; border: 0; border-radius: 14px; overflow: hidden; background: var(--surface); cursor: pointer;
    box-shadow: 0 18px 40px -20px rgb(23 19 31 / 0.55);
    transform-origin: 50% 120%;
    /* Fanned: the finished state. */
    transform: translateX(calc(var(--o) * var(--spread) + var(--lean) * 1.5rem)) rotate(calc(var(--o) * 7deg + var(--lean) * 4deg));
    z-index: calc(10 + var(--i));
    transition: transform 0.2s var(--ease-out);
  }
  .fan__card :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .fan__caption { text-align: center; font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); min-height: 1.5em; }

  /* Live (script + motion): a neat pile until it deals out. */
  .fan:global(.is-live) .fan__card { transition: transform 0.6s cubic-bezier(0.34, 1.3, 0.64, 1); transition-delay: calc(var(--i) * 60ms); }
  .fan:global(.is-live.is-piled) .fan__card { transform: translateX(0) rotate(calc(var(--pile) * 1.2deg)); }
  .fan:global(.is-live.is-dealt) .fan__card { transition: transform 0.2s var(--ease-out); transition-delay: 0s; }
  .fan:global(.is-live) .fan__card:global(.is-lift) {
    transform: translateX(calc(var(--o) * var(--spread))) translateY(-40px) rotate(0deg) scale(1.12);
    z-index: 30;
  }
  .fan__card:focus-visible { outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .fan .fan__card { transition: none; }
  }
</style>
