---
/**
 * 03 Outside/Inside lens (featured work). Each image has an "inside" layer
 * aligned exactly beneath it (a window, not a zoom).
 *  - Fine pointer: a feathered circle follows the pointer and shows the inside.
 *  - Touch: a slice-shaped band wipes the inside in as the image scrolls up.
 *  - Everywhere: a small Outside/Inside switch swaps the whole layer. With reduced
 *    motion it's the only behaviour; with a fine pointer it shows on keyboard focus.
 * Behaviour lives in src/scripts/home.ts.
 */
import { Image } from 'astro:assets';
import WipeHeading from './WipeHeading.astro';
import Note from '../Note.astro';
import { home } from '../../data/home';
import { asset } from '../../data/homeAssets';
import { getWork } from '../../data/work';

const published = await getWork();
const featured = (published.some((p) => p.data.featured) ? published.filter((p) => p.data.featured) : published).slice(0, 2);
---
<section class="feat wrap" aria-labelledby="feat-title" data-featured>
  <div class="row-head">
    <WipeHeading id="feat-title" class="row-head__title" text={home.featured.title} colour="pink" />
    <a class="text-link" href="/work/">All projects <span aria-hidden="true">→</span></a>
  </div>
  <ul role="list" class="feat__grid">
    {featured.map((p, i) => {
      const inside = asset(`feature-0${i + 1}-inside`);
      return (
        <li class="feat__item" data-lens-item>
          <a href={`/work/${p.id}/`} class="feat__link" data-lens-link>
            <div class="feat__media" data-lens-media style={`view-transition-name: cover-${p.id}`}>
              <Image src={p.data.cover} alt="" widths={[640, 960, 1400]} sizes="(max-width: 760px) 92vw, 46vw" loading="lazy" class="feat__img" />
              <div class="feat__inside" data-lens-inside>
                <div class="feat__inside-move scrub">
                  <div class="feat__inside-img scrub">
                    <Image src={inside.src} alt="" widths={[640, 960, 1400]} sizes="(max-width: 760px) 92vw, 46vw" loading="lazy" class="feat__img" />
                  </div>
                  <span class="feat__edge" aria-hidden="true"><i></i><i></i><i></i></span>
                </div>
              </div>
            </div>
            <div class="feat__meta">
              <h3 class="feat__title">{p.data.title}</h3>
              <p class="feat__type">{p.data.status === 'concept' ? 'Concept · ' : ''}{p.data.type}</p>
              <p class="feat__inside-cap">Inside: {home.featured.inside[i]}</p>
            </div>
          </a>
          <button type="button" class="feat__switch" aria-pressed="false" data-lens-switch>
            <span class="feat__switch-opt">Outside</span><span class="feat__switch-opt">Inside</span>
            <span class="visually-hidden"> view of {p.data.title}</span>
          </button>
        </li>
      );
    })}
  </ul>
  <p class="feat__note">{home.featured.note}</p>
  <Note>The name, made literal: the finished work on the outside, the thinking underneath. Hover (or switch) to see the inside of each project.</Note>
</section>

<style>
  @property --lens-r { syntax: '<length>'; inherits: true; initial-value: 0px; }
  .feat { padding-bottom: clamp(6rem, 12vw, 12rem); }
  .feat__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); }
  .feat__item { display: grid; gap: 0.75rem; justify-items: start; }
  .feat__link { display: grid; gap: 1.1rem; width: 100%; text-decoration: none; color: var(--fg); }
  .feat__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--surface); }
  .feat__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .feat__meta { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 1rem; align-items: baseline; }
  .feat__title { font-size: var(--step-1); font-weight: 600; }
  .feat__link:hover .feat__title { color: var(--link); }
  .feat__type { color: var(--muted); font-size: var(--step--1); }
  .feat__inside-cap { grid-column: 1 / -1; font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); display: none; }
  .feat__note { margin-top: 2rem; color: var(--muted); font-size: var(--step--1); }
  @media (max-width: 760px) { .feat__grid { grid-template-columns: 1fr; } }

  /* The inside layer is hidden until a mode below shows it. */
  .feat__inside { position: absolute; inset: 0; visibility: hidden; }
  .feat__inside-move, .feat__inside-img { position: absolute; inset: 0; }
  .feat__edge { display: none; }

  /* Switch (needs JavaScript) */
  .feat__switch { display: none; }
  :global(.js) .feat__switch {
    display: inline-flex; padding: 3px; gap: 0; border: 1.5px solid var(--fg); border-radius: var(--pill);
    background: var(--bg); font-size: 0.8rem; font-weight: 600; min-height: 2.25rem; align-items: center;
  }
  .feat__switch-opt { padding: 0.3rem 0.8rem; border-radius: var(--pill); }
  .feat__switch[aria-pressed='false'] .feat__switch-opt:first-child,
  .feat__switch[aria-pressed='true'] .feat__switch-opt:nth-child(2) { background: var(--fg); color: var(--bg); }
  .feat__item.is-inside .feat__inside { visibility: visible; -webkit-mask-image: none !important; mask-image: none !important; }
  .feat__item.is-inside .feat__inside-move, .feat__item.is-inside .feat__inside-img { animation: none !important; transform: none !important; }
  .feat__item.is-inside .feat__edge { display: none !important; }
  .feat__item.is-inside .feat__inside-cap { display: block; }

  /* Fine pointer: the lens. The switch is there for keyboard users only. */
  .feat.lens-fine .feat__inside {
    visibility: visible;
    --lens-r: 0px;
    -webkit-mask-image: radial-gradient(circle at var(--lx, 50%) var(--ly, 50%), #000 max(0px, calc(var(--lens-r) - 24px)), transparent var(--lens-r));
            mask-image: radial-gradient(circle at var(--lx, 50%) var(--ly, 50%), #000 max(0px, calc(var(--lens-r) - 24px)), transparent var(--lens-r));
    transition: --lens-r 0.16s var(--ease-out);
  }
  .feat.lens-fine .feat__item.is-lens .feat__inside { --lens-r: 110px; transition-duration: 0.2s; }
  .feat.lens-fine .feat__link:focus-visible .feat__inside { --lens-r: 110px; --lx: 50% !important; --ly: 50% !important; }
  .feat.lens-fine .feat__item.is-lens .feat__inside-cap,
  .feat.lens-fine .feat__link:focus-visible .feat__inside-cap { display: block; }
  .feat.lens-fine .feat__switch:not(:focus-visible) {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; padding: 0;
  }
  .feat.lens-fine .feat__item { position: relative; }

  /* Touch: a slice-shaped band wipes the inside in as the image scrolls up. */
  .feat.lens-touch .feat__media { view-timeline: --lens block; --tl: --lens; --range: cover var(--r0, 40%) cover var(--r1, 70%); }
  .feat.lens-touch .feat__inside { visibility: visible; overflow: hidden; }
  .feat.lens-touch .feat__inside-move { animation-name: lens-wipe-move; }
  .feat.lens-touch .feat__inside-img { animation-name: lens-wipe-img; }
  .feat.lens-touch .feat__edge { display: grid; position: absolute; left: 0; right: 0; bottom: -9px; height: 18px; grid-template-rows: 40% 20% 40%; }
  .feat__edge > i { display: block; background: var(--pink); }
  .feat__edge > i:nth-child(2) { transform: translateX(14px); }
  .feat.lens-touch .feat__inside-cap { display: block; }
  @keyframes lens-wipe-move { from { transform: translateY(-100%); } to { transform: translateY(0); } }
  @keyframes lens-wipe-img { from { transform: translateY(100%); } to { transform: translateY(0); } }
</style>
