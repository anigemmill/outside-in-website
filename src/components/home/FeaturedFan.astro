---
/**
 * Featured work as a fanned hand of project cards (effect 09). Each card is a
 * project's 4:5 `card` image and links to its case study. The projects and their
 * order are set in src/data/home.ts (featured.cards).
 */
import WipeHeading from './WipeHeading.astro';
import Fan from './Fan.astro';
import Note from '../Note.astro';
import { home } from '../../data/home';
import { getWork } from '../../data/work';

const work = await getWork();
const cards = home.featured.cards
  .map((slug) => work.find((p) => p.id === slug))
  .filter((p) => p?.data.card)
  .map((p) => ({ src: p!.data.card!, label: p!.data.title, sub: p!.data.type, href: `/projects/${p!.id}/` }));
---
<section class="ffan wrap" aria-labelledby="feat-title" data-fan>
  <div class="row-head">
    <WipeHeading id="feat-title" class="row-head__title" text={home.featured.title} colour="pink" />
    <a class="text-link" href="/projects/">All projects <span aria-hidden="true">→</span></a>
  </div>
  <Fan cards={cards} ratio={5 / 4} width="clamp(9.5rem, 17vw, 15rem)" sizes="(max-width: 760px) 40vw, 15rem" />
  <p class="ffan__note">{home.featured.note}</p>
  <Note>A hand of cards: hover (or tap) to pull one out. It shows range at a glance and invites a click, without a grid of thumbnails.</Note>
</section>

<style>
  .ffan { padding-bottom: clamp(6rem, 12vw, 12rem); }
  .ffan__note { margin-top: 1.5rem; color: var(--muted); font-size: var(--step--1); text-align: center; }
</style>
