---
/**
 * Selected work on the homepage: a few tiles from the Work page, shown exactly
 * as they look there (same component), side by side in a column with wide
 * margins. Pick the tiles in src/data/home.ts (work.tiles, by key).
 */
import WipeHeading from './WipeHeading.astro';
import WorkTile from '../WorkTile.astro';
import Note from '../Note.astro';
import { home } from '../../data/home';
import { tiles as workTiles } from '../../data/workPage';
import { site } from '../../config/site';

const tiles = home.work.tiles
  .map((key) => workTiles.find((t) => t.key === key))
  .filter((t) => t && !(t.previewOnly && site.indexable))
  .map((t) => ({ ...t!, span: 4 as const, h: 560 }));
---
<section class="hw" aria-labelledby="work-title">
  <div class="hw__in">
    <div class="hw__head">
      <p class="label hw__label">{home.work.label}</p>
      <div class="hw__row">
        <WipeHeading id="work-title" class="hw__title" text={home.work.title} colour="pink" />
        <a class="text-link" href="/projects/">All work <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <ul role="list" class="hw__grid">
      {tiles.map((t, i) => <WorkTile tile={t} n={i + 1} headingLevel="h3" compact />)}
    </ul>
    <Note>The same tiles as the Work page, so the homepage gives a taste of the work and the Work page carries the rest.</Note>
  </div>
</section>

<style>
  .hw__in { width: min(1200px, 100% - 2 * var(--gutter)); margin-inline: auto; }
  .hw__head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .hw__label { color: var(--muted); }
  .hw__row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; }
  .hw :global(.hw__title) { font-size: var(--step-4); }
  .hw__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 3rem 1.75rem; margin: 0; padding: 0; }
  @media (max-width: 900px) { .hw__grid { grid-template-columns: 1fr; } }
</style>
