---
/**
 * 11 Scroll-filled statement (homepage v3, section 2). A label on the left and a
 * large statement on the right. As the block scrolls from its top at 80% of the
 * screen to its bottom at 40%, the words fill from grey to ink, one by one; the
 * two words at the leading edge use ink-soft. Not pinned, and reversible.
 *
 * Words are wrapped at build time and hidden from screen readers, which get the
 * plain sentence. Without JavaScript or with reduced motion, it's all ink.
 * Behaviour: setupFill() in src/scripts/home.ts.
 */
interface Props { label: string; text: string; id: string }
const { label, text, id } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
---
<section class="fill col" aria-labelledby={id} data-fill>
  <p class="label fill__label" id={id}>{label}</p>
  <p class="fill__text">
    <span class="visually-hidden">{text}</span>
    <span aria-hidden="true">{words.map((w) => <Fragment><span class="fill__w">{w}</span>{' '}</Fragment>)}</span>
  </p>
</section>

<style>
  .fill { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 1.5rem var(--gutter); align-items: start; }
  .fill__label { padding-top: 0.6em; color: var(--muted); }
  .fill__text { /* 24px minimum: still large text, so the unfilled grey words keep 3:1 contrast. */ font-weight: 500; font-size: clamp(1.5rem, 1rem + 1.6vw, 2.4rem); line-height: 1.2; letter-spacing: -0.015em; max-width: 34ch; }
  /* Live (script, motion): unfilled words are grey (#8C8696, about 3.4:1, fine at
     this size); the leading edge is ink-soft; filled words are ink. */
  .fill:global(.is-live) .fill__w { color: var(--fill-off, var(--ink-grey)); transition: color 0.18s linear; }
  .fill:global(.is-live) .fill__w:global(.is-edge) { color: var(--fill-edge, var(--ink-soft)); }
  .fill:global(.is-live) .fill__w:global(.is-on) { color: var(--fg); }
  :root[data-view='inside'] .fill { --fill-off: #8c8696; --fill-edge: #c9c4d3; }
  @media (max-width: 760px) { .fill { grid-template-columns: 1fr; } .fill__label { padding-top: 0; } }
</style>
