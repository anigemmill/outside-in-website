---
/**
 * 06 Notched service cards. Three disciplines, three cards each. Each card is
 * light grey with its top-right corner cut, a small sketch and a name. On hover
 * or keyboard focus: a photo fades in, an inset border and a square in the cut
 * corner appear in the discipline colour, a short note shows, and the other
 * cards dim. On touch, the row crossing the middle of the screen lights up.
 */
import { Image } from 'astro:assets';
import WipeHeading from './WipeHeading.astro';
import Note from '../Note.astro';
import { services } from '../../data/services';
import { home } from '../../data/home';
import { asset } from '../../data/homeAssets';

const colour = { 'design-creative': 'pink', 'marketing-growth': 'green', 'ai-systems': 'purple' } as const;
---
<section class="svc wrap" aria-labelledby="svc-title" data-cards>
  <div class="row-head">
    <WipeHeading id="svc-title" class="row-head__title" text={home.services.title} colour="purple" />
    <a class="text-link" href="/services/">All services <span aria-hidden="true">→</span></a>
  </div>
  <div class="svc__cols">
    {services.map((s) => (
      <div class="svc__col" data-row style={`--disc: var(--${colour[s.id]})`}>
        <h3 class="svc__name"><span class="svc__dot" aria-hidden="true"></span>{s.name}</h3>
        <ul role="list" class="svc__cards">
          {home.services.cards[s.id].map((c) => {
            const sketch = asset(`service-${c.slug}-sketch`);
            const photo = asset(`service-${c.slug}-photo`);
            return (
              <li class="svc__cell">
                <a class="svc__card" href={`/services/#${s.id}`}>
                  <Image src={photo.src} alt="" widths={[400, 700, 1000]} sizes="(max-width: 760px) 33vw, 30vw" loading="lazy" class="svc__photo" />
                  <Image src={sketch.src} alt="" widths={[300, 600]} sizes="(max-width: 760px) 20vw, 16vw" loading="lazy" class="svc__sketch" />
                  <span class="svc__label">
                    <span class="svc__card-name">{c.name}</span>
                    <span class="svc__note mono">{c.note}</span>
                  </span>
                </a>
                <span class="svc__corner" aria-hidden="true"></span>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
  <Note>Nine things we actually make, grouped by the three disciplines and coloured the same way across the site.</Note>
</section>

<style>
  .svc { padding-bottom: clamp(6rem, 12vw, 12rem); }
  .svc__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 2rem); }
  .svc__name { display: flex; align-items: center; gap: 0.6rem; font-size: var(--step-1); letter-spacing: -0.015em; margin-bottom: 1rem; }
  .svc__dot { width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--disc); box-shadow: 0 0 0 1.5px var(--ink); flex: none; }
  .svc__cards { display: grid; gap: clamp(0.75rem, 1.5vw, 1.25rem); }
  .svc__cell { position: relative; --cut: 28px; transition: opacity 0.15s var(--ease-out); }
  .svc__card {
    position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden;
    background: #f4f2f7; color: var(--ink); text-decoration: none;
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
  }
  .svc__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.18s var(--ease-out); }
  .svc__sketch { position: absolute; right: 0.75rem; bottom: 0.75rem; width: 46%; height: auto; mix-blend-mode: multiply; }
  .svc__label { position: absolute; left: 0.75rem; top: 0.75rem; right: calc(var(--cut) + 0.5rem); display: grid; gap: 0.35rem; justify-items: start; }
  .svc__card-name { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); line-height: 1.1; letter-spacing: -0.015em; background: #f4f2f7; padding: 0.15rem 0.35rem; margin: -0.15rem -0.35rem; }
  .svc__note { opacity: 0; background: var(--white); color: var(--ink); padding: 0.2rem 0.4rem; border-radius: 4px; transition: opacity 0.18s var(--ease-out); }
  .svc__card::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 2px var(--disc); opacity: 0; transition: opacity 0.18s var(--ease-out); }
  .svc__corner { position: absolute; top: 0; right: 0; width: calc(var(--cut) - 6px); height: calc(var(--cut) - 6px); background: var(--disc); opacity: 0; transform: scale(0.4); transition: opacity 0.18s var(--ease-out), transform 0.22s var(--ease-out-back); pointer-events: none; }

  /* The "on" state: hover (fine pointers), keyboard focus, or the touch row in the middle. */
  .svc__card:focus-visible .svc__photo,
  .svc__card:focus-visible .svc__note,
  .svc__card:focus-visible::after,
  .svc__card:focus-visible + .svc__corner,
  .svc__col.is-hot .svc__photo, .svc__col.is-hot .svc__note, .svc__col.is-hot .svc__card::after, .svc__col.is-hot .svc__corner { opacity: 1; }
  .svc__card:focus-visible + .svc__corner, .svc__col.is-hot .svc__corner { transform: none; }
  .svc__card:focus-visible .svc__card-name, .svc__col.is-hot .svc__card-name { background: var(--white); }
  .svc__cols:has(.svc__card:focus-visible) .svc__cell:not(:has(.svc__card:focus-visible)) { opacity: 0.55; transition-duration: 0.2s; }
  @media (hover: hover) and (pointer: fine) {
    .svc__card:hover .svc__photo, .svc__card:hover .svc__note, .svc__card:hover::after, .svc__card:hover + .svc__corner { opacity: 1; }
    .svc__card:hover + .svc__corner { transform: none; }
    .svc__card:hover .svc__card-name { background: var(--white); }
    .svc__cols:has(.svc__card:hover) .svc__cell:not(:has(.svc__card:hover)) { opacity: 0.55; transition-duration: 0.2s; }
  }
  :global(.js) .svc__card:focus-visible { outline-offset: 4px; }

  @media (max-width: 760px) {
    .svc__cols { grid-template-columns: 1fr; gap: 2.5rem; }
    .svc__cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; }
    .svc__cell { --cut: 16px; }
    .svc__card { aspect-ratio: 3 / 4; }
    .svc__card-name { font-size: 0.85rem; }
    .svc__label { left: 0.4rem; top: 0.4rem; right: 0.4rem; }
    .svc__note { display: none; }
    .svc__sketch { width: 70%; right: 0.4rem; bottom: 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc__cols .svc__cell { opacity: 1 !important; }
  }
</style>
