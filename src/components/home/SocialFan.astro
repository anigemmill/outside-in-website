---
/**
 * 09 Social fan. Phone-shaped cards start as a neat pile, then deal out into a fan
 * when the pile comes into view. Hover or focus lifts a card and shows its client
 * and campaign; the neighbours lean away. On touch, tapping flicks the top card to
 * the back. Reduced motion: already fanned, no lift.
 */
import { Image } from 'astro:assets';
import Note from '../Note.astro';
import { home } from '../../data/home';
import { asset } from '../../data/homeAssets';

const posts = home.social.posts;
const mid = (posts.length - 1) / 2;
---
<section class="fan-sec wrap" aria-labelledby="fan-title" data-fan>
  <h2 id="fan-title" class="row-head__title fan-sec__title">{home.social.title}</h2>
  <div class="fan" data-fan-deck style={`--n: ${posts.length}`}>
    {posts.map((p, i) => {
      const img = asset(p.image);
      return (
        <button
          type="button"
          class="fan__card"
          style={`--i: ${i}; --o: ${i - mid}; --pile: ${((i * 37) % 7) - 3}`}
          data-fan-card
          data-caption={`${p.client} · ${p.campaign}`}
          aria-label={`${p.client}, ${p.campaign}`}
        >
          <Image src={img.src} alt="" widths={[270, 540]} sizes="(max-width: 760px) 34vw, 13rem" loading="lazy" />
        </button>
      );
    })}
  </div>
  <p class="fan__caption" aria-hidden="true" data-fan-caption>&nbsp;</p>
  <Note>Social work is made to be swiped, so it's shown as a hand of phones you can flick through.</Note>
</section>

<style>
  .fan-sec { padding-bottom: clamp(6rem, 12vw, 12rem); }
  .fan-sec__title { margin-bottom: clamp(1rem, 3vw, 2rem); }
  .fan { --cw: clamp(8.5rem, 15vw, 13rem); --spread: clamp(2.6rem, 9vw, 8.5rem); position: relative; height: calc(var(--cw) * 16 / 9 + 6rem); overflow: clip; overflow-clip-margin: 0px; }
  .fan__card {
    --lean: 0;
    position: absolute; left: 50%; top: 2.5rem; width: var(--cw); aspect-ratio: 9 / 16; margin-left: calc(var(--cw) / -2);
    padding: 0; border: 0; border-radius: 14px; overflow: hidden; background: var(--surface);
    box-shadow: 0 18px 40px -20px rgb(23 19 31 / 0.55);
    transform-origin: 50% 120%;
    /* Fanned: the finished state. */
    transform: translateX(calc(var(--o) * var(--spread) + var(--lean) * 1.5rem)) rotate(calc(var(--o) * 7deg + var(--lean) * 4deg));
    z-index: calc(10 + var(--i));
    transition: transform 0.2s var(--ease-out);
  }
  .fan__card img { width: 100%; height: 100%; object-fit: cover; }
  .fan__caption { text-align: center; font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); min-height: 1.5em; }

  /* Live (script + motion): a neat pile until it deals out. */
  .fan.is-live .fan__card { transition: transform 0.6s cubic-bezier(0.34, 1.3, 0.64, 1); transition-delay: calc(var(--i) * 60ms); }
  .fan.is-live.is-piled .fan__card { transform: translateX(0) rotate(calc(var(--pile) * 1.2deg)); }
  .fan.is-live.is-dealt .fan__card { transition: transform 0.2s var(--ease-out); transition-delay: 0s; }
  .fan.is-live .fan__card.is-lift {
    transform: translateX(calc(var(--o) * var(--spread))) translateY(-40px) rotate(0deg) scale(1.08);
    z-index: 30;
  }
  .fan__card:focus-visible { outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .fan .fan__card { transition: none; }
  }
</style>
