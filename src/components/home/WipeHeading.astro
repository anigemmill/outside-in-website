---
/**
 * 02 Slice-wipe headline. A band in a palette colour sweeps in from the left over
 * each line, holds, then leaves to the right and uncovers the text. The middle
 * 20% of the band is shifted right, like the logo's slice.
 *
 * Words are wrapped so src/scripts/home.ts can find the lines. The text is always
 * in the DOM; only its paint is hidden before the wipe, so nothing shifts.
 * Without JavaScript, or with reduced motion, it's a plain heading.
 */
interface Props {
  text: string;
  colour: 'red' | 'pink' | 'purple' | 'green';
  tag?: 'h2' | 'h3' | 'p';
  id?: string;
  class?: string;
}
const { text, colour, tag: Tag = 'h2', id, class: className } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
---
<Tag id={id} class:list={['wipe', className]} data-wipe style={`--wipe: var(--${colour})`}>
  {words.map((w) => <Fragment><span class="wipe__w">{w}</span>{' '}</Fragment>)}
</Tag>

<style is:global>
  .wipe { position: relative; }
  .wipe__w { display: inline; }
  .wipe--armed .wipe__w { opacity: 0; }
  .wipe__band {
    position: absolute; pointer-events: none; z-index: 1;
    transform: scaleX(0); transform-origin: left center;
    display: grid; grid-template-rows: 40% 20% 40%;
  }
  .wipe__band > i { display: block; background: var(--wipe); }
  .wipe__band > i:nth-child(2) { transform: translateX(0.33em); }
</style>
