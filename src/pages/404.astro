---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="Page not found" description="This page doesn’t exist." noindex>
  <section class="wrap lost">
    <Logo id="oi-404" animate="load" decorative class="lost__logo" />
    <p class="eyebrow">404</p>
    <h1 class="h-xl">This page is outside the site.</h1>
    <p class="lede">The link may be old or mistyped. Here’s the way back in.</p>
    <div class="btn-row"><a class="btn btn--accent" href="/">Go home</a><a class="btn btn--ghost" href="/work/">See the work</a><a class="btn btn--ghost" href="/contact/">Contact us</a></div>
  </section>
</Base>
<style>
  .lost { display: grid; gap: 1.5rem; justify-items: start; padding-block: var(--section); }
  :global(.lost__logo) { width: min(240px, 50vw); color: var(--fg); }
</style>
