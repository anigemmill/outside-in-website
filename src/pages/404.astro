---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="Page not found" description="This page doesn’t exist." noindex>
  <section class="band lost">
    <div class="wrap lost__in">
      <div class="lost__mark"><Logo id="oi-404" variant="hero" decorative /></div>
      <p class="label">[ 404 ]</p>
      <h1 class="lost__title">This page is <em class="em">outside the site.</em></h1>
      <p class="lost__lede">The link may be old or mistyped. Here’s the way back in.</p>
      <div class="lost__actions"><a class="pill pill--maroon pill--lg" href="/">Go home</a><a class="pill pill--outline pill--lg" href="/work/">See our work</a><a class="pill pill--outline pill--lg" href="/contact/">Contact us</a></div>
    </div>
  </section>
</Base>
<style>
  .lost__in { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .lost__mark { width: min(240px, 50vw); color: var(--orange); margin-bottom: 16px; }
  .lost__title { font-size: clamp(44px, 6vw, 88px); line-height: 0.95; letter-spacing: -0.05em; }
  .lost__title .em { color: var(--orange); letter-spacing: -0.02em; }
  .lost__lede { font-size: 19px; }
  .lost__actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
