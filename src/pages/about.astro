---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Note from '../components/Note.astro';
import Logo from '../components/Logo.astro';
import BookingLink from '../components/BookingLink.astro';
import { about } from '../data/about';
import { site } from '../config/site';
---
<Base
  title="About"
  description="Why Outside In brings creativity, marketing and AI together, and what that means for the businesses we work with."
>
  <PageHero eyebrow="About" dot="purple" title="Close enough to care. Far enough to see." lede={about.lede} />

  <figure class="wrap mark-panel">
    <div class="mark-panel__inner">
      <Logo id="oi-about" animate="load" decorative class="mark-panel__logo" />
    </div>
    <figcaption class="mark-panel__cap">The O and the I are each cut by one slice, shifted right. On the O it pushes in on one side and out on the other. Same shape, new perspective.</figcaption>
  </figure>

  <section class="wrap row" aria-labelledby="why-title">
    <h2 id="why-title" class="row__title">{about.why.title}</h2>
    <div class="row__content prose">
      {about.why.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="wrap row" aria-labelledby="name-title">
    <h2 id="name-title" class="row__title">The name</h2>
    <div class="row__content name-cols">
      {about.name.map((n, i) => (
        <div data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <h3 class="name-cols__h">{n.title}</h3>
          <p class="muted">{n.text}</p>
        </div>
      ))}
    </div>
  </section>

  {about.people.length > 0 && (
    <section class="wrap row" aria-labelledby="people-title">
      <h2 id="people-title" class="row__title">Who you’ll work with</h2>
      <ul role="list" class="row__content people">
        {about.people.map((p) => (
          <li><h3 class="name-cols__h">{p.name}</h3><p class="muted">{p.role}</p><p>{p.bio}</p></li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap row" aria-labelledby="who-title">
    <h2 id="who-title" class="row__title">{about.who.title}</h2>
    <ul role="list" class="row__content who">
      {about.who.list.map((w) => <li><strong>{w.name}</strong><span class="muted">{w.text}</span></li>)}
    </ul>
    <Note>Names the audiences from the brief so each visitor can find themselves on the page, without inventing a client list.</Note>
  </section>

  <section class="wrap about-cta" aria-label="Get in touch">
    <p>Based in {site.location}. Working with businesses here and further afield.</p>
    <BookingLink />
  </section>
</Base>

<style>
  .mark-panel { margin: 0 auto; padding-bottom: clamp(5rem, 10vw, 9rem); }
  .mark-panel__inner {
    display: grid; place-items: center; aspect-ratio: 16 / 8; border-radius: var(--radius);
    background: var(--red); color: var(--green);
  }
  :global(.mark-panel__logo) { width: min(46%, 520px); }
  .mark-panel__cap { margin-top: 1rem; color: var(--muted); font-size: var(--step--1); max-width: 60ch; }
  @media (max-width: 640px) { .mark-panel__inner { aspect-ratio: 4 / 3; } :global(.mark-panel__logo) { width: 70%; } }

  .row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 1.5rem var(--gutter); padding-block: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--line); }
  .row__title { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; max-width: 16ch; }
  .row__content { min-width: 0; }
  .row .prose { font-size: var(--step-1); line-height: 1.5; max-width: 56ch; }
  @media (max-width: 860px) { .row { grid-template-columns: 1fr; } }

  .name-cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .name-cols > div { display: grid; gap: 0.6rem; align-content: start; }
  .name-cols__h { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; }
  @media (max-width: 640px) { .name-cols { grid-template-columns: 1fr; } }

  .people { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--gutter); padding: 0; }

  .who { display: grid; padding: 0; }
  .who li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 0.25rem var(--gutter); padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .who li:first-child { padding-top: 0; }
  .who strong { font-weight: 600; }
  @media (max-width: 640px) { .who li { grid-template-columns: 1fr; } }

  .about-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 2rem clamp(6rem, 12vw, 12rem); border-top: 1px solid var(--line); font-size: var(--step-1); }
</style>
