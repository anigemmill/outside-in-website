---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Note from '../components/Note.astro';
import BookingLink from '../components/BookingLink.astro';

// Edit the approach here.
const stages = [
  {
    n: '01', name: 'Look outside',
    text: 'We start where your customers are. How do they find you, what do they compare you with, and what do they see that you might not? We look at your audience, your market and your competitors with fresh eyes.',
    youGet: 'A clear picture of how you’re seen from outside',
  },
  {
    n: '02', name: 'Look inside',
    text: 'Then we look at how the business works: goals, team, tools, data and the jobs that eat time. This is where we agree what success means and how we’ll measure it.',
    youGet: 'An agreed goal, a baseline and a measure',
  },
  {
    n: '03', name: 'Decide',
    text: 'The strategy lives where the two views meet. We recommend what to do, what to leave alone and in what order, with effort and value spelled out so the choice is yours.',
    youGet: 'A prioritised plan you can say yes or no to',
  },
  {
    n: '04', name: 'Build',
    text: 'Then we make it: brand, website, campaign, content, automation or AI system. You see work early and often, so there are no big reveals that miss the point.',
    youGet: 'Finished work, documented and handed over',
  },
  {
    n: '05', name: 'Measure and refine',
    text: 'We check results against the goal we agreed in stage two and improve what isn’t working. For ongoing partners, this becomes the monthly rhythm.',
    youGet: 'A report that ends with a recommendation',
  },
];

const tracks = [
  {
    name: 'Creative projects',
    text: 'These move quickly through ideas. We share early concepts, agree a direction together, then refine. Feedback rounds are planned into the timeline from the start.',
  },
  {
    name: 'Marketing campaigns',
    text: 'Each one is built as an experiment. Every campaign has a hypothesis and a measure, so whatever happens, you learn something you can use next time.',
  },
  {
    name: 'AI and automation',
    text: 'This starts small. We pilot one workflow with real data and real people before anything scales, and a human stays in control of decisions that matter.',
  },
];
---
<Base
  title="Approach"
  description="How Outside In works: look outside, look inside, decide, build, then measure and refine. Creative, marketing and AI projects each follow the rhythm that suits them."
>
  <PageHero
    eyebrow="Approach"
    dot="green"
    title="First we look out. Then we look in."
    lede="Good work starts with seeing the problem clearly. We move from your customers’ view to your business’s inner workings, and back out again with something that works."
  />

  <section class="wrap stages-wrap" aria-label="How a project runs">
    <ol class="stages" role="list">
      {stages.map((s, i) => (
        <li class="stage" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
          <span class="stage__n">{s.n}</span>
          <h2 class="stage__name">{s.name}</h2>
          <div class="stage__body">
            <p>{s.text}</p>
            <p class="stage__get"><span>You get</span> {s.youGet}</p>
          </div>
        </li>
      ))}
    </ol>
    <Note>Five stages named in plain language. “Look outside, look inside” turns the agency name into a method a client can remember and repeat.</Note>
  </section>

  <section class="wrap tracks" aria-labelledby="tracks-title">
    <div class="tracks__head">
      <h2 id="tracks-title" class="tracks__title">Different work moves at a different pace.</h2>
    </div>
    <ul role="list" class="tracks__list">
      {tracks.map((t, i) => (
        <li data-reveal style={`--reveal-delay:${i * 0.06}s`}>
          <span class="tracks__swatch" style={`--c: var(--${['pink', 'green', 'purple'][i]})`} aria-hidden="true"></span>
          <h3 class="tracks__name">{t.name}</h3>
          <p class="muted">{t.text}</p>
        </li>
      ))}
    </ul>
    <div class="tracks__cta">
      <p>Not sure which applies to you? That’s what the discovery call is for.</p>
      <BookingLink />
    </div>
  </section>
</Base>

<style>
  .stages-wrap { padding-bottom: clamp(5rem, 10vw, 9rem); }
  .stages { display: grid; padding: 0; }
  .stage {
    display: grid; grid-template-columns: 4rem minmax(0, 4fr) minmax(0, 7fr); gap: 0.75rem var(--gutter);
    padding-block: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); align-items: start;
  }
  .stage:last-child { border-bottom: 1px solid var(--line); }
  .stage__n { color: var(--muted); font-size: var(--step--1); padding-top: 0.7rem; }
  .stage__name { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; }
  .stage__body { display: grid; gap: 1rem; font-size: var(--step-1); line-height: 1.45; max-width: 52ch; }
  .stage__get { font-size: var(--step-0); color: var(--muted); }
  .stage__get span { color: var(--fg); font-weight: 600; margin-right: 0.35rem; }
  @media (max-width: 860px) {
    .stage { grid-template-columns: 2.5rem 1fr; }
    .stage__body { grid-column: 2; }
  }

  .tracks { padding-bottom: clamp(6rem, 12vw, 12rem); }
  .tracks__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .tracks__title { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; max-width: 20ch; }
  .tracks__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); padding: 0; }
  .tracks__list li { display: grid; gap: 0.75rem; align-content: start; }
  .tracks__swatch { width: 100%; aspect-ratio: 16 / 9; border-radius: var(--radius); background: var(--c); margin-bottom: 0.5rem; }
  .tracks__name { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; }
  .tracks__cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; margin-top: clamp(3rem, 6vw, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: var(--step-1); }
  @media (max-width: 860px) { .tracks__list { grid-template-columns: 1fr; } }
</style>
