---
/** Contact (mockup: design/source/contact.html): orange panel with the booking link, blue form panel. */
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import BookCall from '../../components/BookCall.astro';
import { site } from '../../config/site';

const words = [
  { w: 'Got', d: 0.05 }, { w: 'an', d: 0.12 }, { w: 'idea?', d: 0.19 },
  { w: 'Let’s', d: 0.32, em: true }, { w: 'make', d: 0.39, em: true }, { w: 'it', d: 0.46, em: true }, { w: 'real.', d: 0.53, em: true },
];
---
<Base title="Contact" description="Got an idea? Tell Outside In a little about it, or book a discovery call. Brand, websites, campaigns, marketing and AI.">
  <div class="ct">
    <div class="wrap ct__in">
      <section class="ct__panel on-orange" aria-labelledby="ct-title">
        <span class="tag tag--cream ct__label">[ Contact ]</span>
        <h1 id="ct-title" class="ct__title">
          {words.map((x, i) => (
            <>{x.em ? <em class="em word" style={`animation-delay:${x.d}s`}>{x.w}</em> : <span class="word" style={`animation-delay:${x.d}s`}>{x.w}</span>}{i < words.length - 1 && ' '}</>
          ))}
        </h1>
        <div class="ct__reach">
          <BookCall class="pill pill--maroon ct__book" />
          <a href={`mailto:${site.email}`} data-contact-email>{site.email}</a>
          <span>{site.place}</span>
        </div>
      </section>
      <div class="ct__form on-blue" id="enquiry">
        <ContactForm />
      </div>
    </div>
  </div>
</Base>

<style>
  .ct { padding: clamp(24px, 3vw, 40px) var(--gutter) clamp(48px, 6vw, 80px); }
  .ct__in { display: flex; flex-wrap: wrap; gap: 20px; }
  .ct__panel { flex: 1 1 480px; padding: clamp(32px, 4vw, 56px); min-height: 760px; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; gap: 48px; }
  .ct__label { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
  .ct__title { font-weight: 500; font-size: clamp(56px, 7vw, 108px); line-height: 0.92; letter-spacing: -0.05em; }
  .ct__title .em { letter-spacing: -0.02em; }
  .word { display: inline-block; animation: word-up 0.8s var(--ease-out) both; }
  @keyframes word-up { from { transform: translateY(60%); opacity: 0; } to { transform: none; opacity: 1; } }
  /* Cream on orange is large-text only, so the details run at 24px. */
  .ct__reach { display: flex; flex-direction: column; gap: 14px; font-size: 24px; line-height: 1.25; }
  .ct__reach a:not(.pill) { overflow-wrap: anywhere; min-height: 44px; display: inline-flex; align-items: center; }
  .ct__reach :global(.ct__book) { min-height: 56px; padding: 0 28px; font-size: 18px; }
  .ct__form { flex: 1 1 480px; padding: clamp(32px, 4vw, 56px); }
  @media (max-width: 600px) {
    .ct__panel { min-height: 0; padding-inline: 20px; }
    .ct__form { padding-inline: 20px; }
    .ct__panel, .ct__form { flex-basis: 100%; }
    .ct__reach { font-size: 20px; font-weight: 700; }
  }
</style>
