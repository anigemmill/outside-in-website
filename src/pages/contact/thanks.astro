---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
---
<Base title="Thanks" description="Your enquiry has been sent to Outside In." noindex>
  <section class="wrap thanks">
    <p class="eyebrow">Enquiry sent</p>
    <h1 class="h-xl">Thanks. We’ve got it.</h1>
    <p class="lede">We’ll reply to the email you gave us within {site.replyWithin}.</p>
    <div class="btn-row"><a class="btn btn--accent" href="/work/">Look at the work while you wait</a><a class="btn btn--ghost" href="/">Back home</a></div>
  </section>
</Base>
<style>.thanks { display: grid; gap: 1.5rem; justify-items: start; padding-block: var(--section); }</style>
