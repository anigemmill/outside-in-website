---
/**
 * FINDABLE: landing page, built from the "Findable — Website Mockups" canvas.
 *
 * Copy follows the mockup. Text in [square brackets] is a placeholder from the
 * mockup and is shown highlighted (.f-ph) until Ani supplies the real figure
 * or source. Several lines describe the planned AI-visibility product (testing
 * six AI platforms, monthly re-tests) rather than what the app does today;
 * confirm before this page goes to production.
 */
import FindableLayout from '../../layouts/FindableLayout.astro';

const platforms = ['ChatGPT', 'Perplexity', 'Gemini', 'Google AI Overviews', 'Copilot', 'Claude'];
const steps = [
  { n: '01', t: 'Ask', d: 'We put the questions your visitors really ask to every major AI.' },
  { n: '02', t: 'Score', d: 'You get a visibility score: are you mentioned, recommended, accurate?' },
  { n: '03', t: 'Fix', d: 'A prioritised fix list for your website, listings and content.' },
  { n: '04', t: 'Track', d: 'We re-test monthly so you can see the change, not just hope for it.' },
];
const gets = [
  'Visibility score across six AI platforms',
  'The exact answers AI gives about you, and about your competitors',
  'Accuracy check: hours, prices, location, what you offer',
  'A ranked fix list with plain-English instructions',
];
// Bar widths are illustrative, as the card says.
const bars = [['ChatGPT', 78], ['Perplexity', 55], ['Gemini', 40], ['AI Overviews', 66], ['Claude', 60], ['Copilot', 48]] as const;
const who = [
  { t: 'Operators', d: 'Tours, attractions, accommodation and activities that want more direct bookings from AI-assisted trip planning.', bg: 'var(--f-mint)' },
  { t: 'Destinations', d: 'Regional tourism organisations that want their whole region, and its operators, described well by AI.', bg: 'var(--f-cream)' },
  { t: 'Agencies & marketers', d: 'Teams managing several tourism brands who need one clear view of AI visibility across clients.', bg: 'var(--f-lime)' },
];
const faqs = [
  { q: 'What is “AI visibility”?', a: 'How often, and how well, AI assistants mention and recommend your business when people ask for things to do.' },
  { q: 'Is this just SEO with a new name?', a: 'It builds on good SEO, but AI answers pull from different signals. We test the answers directly, not just your rankings.' },
  { q: 'Do I need to know anything about AI?', a: 'No. Every fix comes with plain-English steps, and most are things you already control.' },
  { q: 'Can you guarantee AI will recommend me?', a: 'No one honestly can. We measure, fix what’s in your control, and show you the change month by month.' },
];
---
<FindableLayout title="Findable" current="home" description="Findable shows tourism businesses in Aotearoa New Zealand whether AI assistants recommend them, and what to fix so they do. Run a free visibility check.">

  <section class="f-wrap hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="f-d hero__title">Be the<br />answer<span>.</span></h1>
    <div class="hero__base">
      <span class="f-lbl">AI visibility for tourism · Aotearoa NZ</span>
      <div class="hero__ctas">
        <a href="#why" class="f-lbl hero__scroll">Scroll <span aria-hidden="true">↓</span></a>
        <a href="/findable/check/" class="f-btn f-btn-p">Run my free check <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="why" class="shift" aria-labelledby="shift-title">
    <div class="f-wrap shift__in">
      <div class="f-stack">
        <span class="f-lbl c-forest">The shift</span>
        <h2 id="shift-title" class="f-d f-hxl">Visitors don’t search any more. They ask.</h2>
        <p class="f-lede">They ask ChatGPT, Perplexity and Google’s AI where to go, and get two or three names back, not ten links. Findable shows you whether you’re one of them, and exactly what to fix so you are.</p>
        <div class="f-row">
          <a href="/findable/check/" class="f-btn f-btn-s">Run my free check <span aria-hidden="true">→</span></a>
          <a href="/findable/how-it-works/" class="f-btn f-btn-g">How it works</a>
        </div>
        <span class="f-lbl c-ink3">Free · 2 minutes · No card needed</span>
      </div>

      <figure class="ask" aria-label="Example: a visitor asks an AI assistant">
        <span class="f-lbl c-lime">A visitor asks</span>
        <p class="ask__q">“What’s the best guided mountain bike experience in Rotorua?”</p>
        <div class="f-row f-row-t">
          <span class="f-tag t-violet">ChatGPT</span><span class="f-tag t-violet">Perplexity</span><span class="f-tag t-violet">AI Overviews</span>
        </div>
        <div class="ask__a">
          <span class="f-lbl c-violet-ink">AI answer</span>
          For a guided ride, <strong class="ask__you">[Your business]</strong> is a top pick: local guides, trails for every level and gear included. Other options include …
        </div>
        <div class="f-row f-row-t ask__foot">
          <span class="f-tag t-lime">Recommended</span>
          <span>Mentioned first · described accurately</span>
        </div>
      </figure>
    </div>
    <div class="plat">
      <div class="f-wrap plat__in">
        <span class="f-lbl">We test what visitors ask on</span>
        <ul role="list" class="plat__list">
          {platforms.map((p) => <li class="f-d">{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="stakes" aria-labelledby="stakes-title">
    <div class="f-wrap stakes__in">
      <div class="f-split f-split-end">
        <h2 id="stakes-title" class="f-d f-hlg">Not in the answer? Not in the running.</h2>
        <p class="stakes__lede">If the AI doesn’t know you, or gets your hours, prices or location wrong, visitors book someone else without ever seeing your website.</p>
      </div>
      <ul role="list" class="stats">
        <li class="stat" style="background: var(--f-lime)">
          <span class="f-d stat__n"><span class="f-ph">[X]</span>%</span>
          <span>of travellers now use AI tools to plan trips</span>
          <span class="f-lbl stat__src">Source · <span class="f-ph">[research source]</span></span>
        </li>
        <li class="stat" style="background: var(--f-cream)">
          <span class="f-d stat__n">2–3</span>
          <span>businesses typically named in a single AI recommendation</span>
          <span class="f-lbl stat__src">Source · <span class="f-ph">[our testing]</span></span>
        </li>
        <li class="stat" style="background: var(--f-lav)">
          <span class="f-d stat__n"><span class="f-ph">[X]</span> of 10</span>
          <span>operators we tested had wrong details in AI answers</span>
          <span class="f-lbl stat__src">Source · <span class="f-ph">[our audits]</span></span>
        </li>
      </ul>
    </div>
  </section>

  <section class="f-wrap pad-t" aria-labelledby="steps-title">
    <div class="steps">
      <div class="steps__head">
        <div class="f-stack f-stack-s">
          <span class="f-lbl">How it works</span>
          <h2 id="steps-title" class="f-d f-hmd">Four steps to findable.</h2>
        </div>
        <a href="/findable/how-it-works/" class="f-btn f-btn-w">See the full process <span aria-hidden="true">→</span></a>
      </div>
      <ol role="list" class="steps__list">
        {steps.map((s) => (
          <li>
            <span class="f-d steps__n" aria-hidden="true">{s.n}</span>
            <h3 class="steps__t">{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="f-wrap get" aria-labelledby="get-title">
    <div class="f-stack">
      <span class="f-lbl c-forest">What you get</span>
      <h2 id="get-title" class="f-d f-hmd">A report you can act on this week.</h2>
      <p class="f-body">No jargon, no 80-page audit. Your score, what each AI says about you, and the handful of fixes that will move it.</p>
      <ul role="list" class="dots">
        {gets.map((g) => <li>{g}</li>)}
      </ul>
    </div>
    <figure class="report" aria-labelledby="report-cap">
      <div class="report__top">
        <span class="f-lbl c-ink3">Visibility report · sample</span>
        <span class="f-tag t-mint">Rotorua · Adventure</span>
      </div>
      <div class="report__score">
        <span class="f-d report__n f-ph">[00]</span>
        <span class="c-ink3">/ 100 visibility score</span>
      </div>
      <ul role="list" class="bars" aria-hidden="true">
        {bars.map(([name, w]) => (
          <li><span>{name}</span><span class="bars__track"><span style={`width:${w}%`}></span></span></li>
        ))}
      </ul>
      <div class="report__fix">
        <span class="f-tag t-alert">Fix #1</span>
        <span>Your opening hours are wrong in two AI answers. Update your Google Business Profile and website FAQ.</span>
      </div>
      <figcaption id="report-cap" class="f-lbl c-ink3">Illustrative layout · real scores come from your check</figcaption>
    </figure>
  </section>

  <section class="f-wrap pad-b" aria-labelledby="who-title">
    <div class="f-stack f-stack-s">
      <span class="f-lbl c-forest">Who it’s for</span>
      <h2 id="who-title" class="f-d f-hmd">Built for tourism.</h2>
    </div>
    <ul role="list" class="who">
      {who.map((w, i) => (
        <li style={`background:${w.bg}`}>
          <span class="f-d who__n" aria-hidden="true">0{i + 1}</span>
          <h3 class="who__t">{w.t}</h3>
          <p>{w.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="f-wrap pad-b faq" aria-labelledby="faq-title">
    <div class="f-stack f-stack-s">
      <span class="f-lbl c-forest">Questions</span>
      <h2 id="faq-title" class="f-d f-hmd">Fair questions.</h2>
    </div>
    <div class="faq__list">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="f-wrap pad-b" aria-labelledby="cta-title">
    <div class="cta">
      <h2 id="cta-title" class="f-d f-hlg">Does AI recommend you?</h2>
      <!-- Hands the address to the free check form, which asks for the rest. -->
      <form class="f-stack f-stack-s" action="/findable/check/" method="get">
        <label for="cta-site" class="cta__label">Your website</label>
        <div class="f-row f-row-t">
          <input id="cta-site" name="website" class="f-in cta__in" type="text" inputmode="url" autocomplete="url" placeholder="yourbusiness.co.nz" />
          <button type="submit" class="f-btn f-btn-s">Run my free check <span aria-hidden="true">→</span></button>
        </div>
        <span class="cta__note">Results in your inbox. No card needed.</span>
      </form>
    </div>
  </section>
</FindableLayout>

<style>
  .pad-t { padding-top: clamp(72px, 9vw, 112px); padding-bottom: 72px; }
  .pad-b { padding-bottom: clamp(72px, 9vw, 112px); display: flex; flex-direction: column; gap: 40px; }

  /* Hero */
  .hero { min-height: clamp(480px, 78svh, 720px); display: flex; flex-direction: column; justify-content: space-between; gap: 48px; padding-block: 48px; }
  .hero__title { margin: 0; font-size: clamp(64px, 17vw, 260px); line-height: 0.84; letter-spacing: -0.055em; }
  .hero__title span { color: var(--f-forest); }
  .hero__base { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; border-top: 1.5px solid var(--f-ink); padding-top: 20px; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  :global(.findable) .hero__scroll { text-decoration: none; padding-block: 12px; }

  /* The shift */
  .shift { background: var(--f-lime); }
  .shift__in { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 48px; align-items: center; padding-block: clamp(72px, 9vw, 112px); }
  .ask { margin: 0; background: var(--f-forest); border-radius: var(--f-radius); padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; gap: 16px; }
  .ask__q { margin: 0; background: var(--f-cream); border-radius: 16px; padding: 20px 24px; font-size: 18px; line-height: 1.4; }
  .ask__a { background: var(--f-lav); border-radius: 16px; padding: 24px; font-size: 16px; line-height: 1.6; }
  .ask__you { background: var(--f-lime); padding: 2px 6px; border-radius: 6px; }
  .ask__foot { color: var(--f-paper); font-size: 14px; }
  .plat { border-top: 1.5px solid var(--f-ink); }
  .plat__in { display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: center; padding-block: 28px; }
  .plat__list { display: flex; flex-wrap: wrap; gap: 12px 40px; margin: 0; padding: 0; }
  .plat__list li { font-size: 22px; letter-spacing: -0.02em; }

  /* Stakes */
  .stakes { background: var(--f-forest); color: var(--f-paper); }
  .stakes__in { padding-block: clamp(72px, 9vw, 112px); display: flex; flex-direction: column; gap: 48px; }
  .stakes__lede { margin: 0; font-size: 18px; line-height: 1.6; color: #dfe6dc; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; margin: 0; padding: 0; }
  .stat { color: var(--f-ink); border-radius: var(--f-radius); padding: 32px 24px; display: flex; flex-direction: column; gap: 12px; min-height: 200px; font-size: 15px; line-height: 1.5; }
  .stat__n { font-size: 56px; line-height: 1; font-weight: 600; }
  .stat__src { margin-top: auto; }

  /* Steps */
  .steps { background: var(--f-blue); color: #fff; border-radius: var(--f-radius); padding: clamp(24px, 4vw, 48px); display: flex; flex-direction: column; gap: 40px; }
  .steps__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; }
  .steps__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 24px; margin: 0; padding: 0; }
  .steps__list li { border-top: 1px solid rgb(255 255 255 / 0.4); padding-top: 16px; display: flex; flex-direction: column; gap: 8px; font-size: 15px; line-height: 1.5; }
  .steps__list p { margin: 0; }
  .steps__n { font-size: 48px; line-height: 1; font-weight: 600; }
  .steps__t { margin: 0; font-size: 18px; }

  /* What you get */
  .get { padding-top: 72px; padding-bottom: clamp(72px, 9vw, 112px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 48px; align-items: center; }
  .dots { margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 16px; }
  .dots li { display: flex; gap: 12px; align-items: baseline; }
  .dots li::before { content: ''; width: 10px; height: 10px; border-radius: 999px; background: var(--f-forest); flex: none; transform: translateY(-1px); }
  .report { margin: 0; background: #fff; border-radius: var(--f-radius); padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; gap: 24px; border: 1px solid var(--f-line); }
  .report__top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .report__score { display: flex; align-items: end; gap: 12px; flex-wrap: wrap; font-size: 18px; }
  .report__score > span:last-child { padding-bottom: 10px; }
  .report__n { font-size: clamp(64px, 8vw, 96px); line-height: 0.9; }
  .bars { display: flex; flex-direction: column; gap: 14px; margin: 0; padding: 0; }
  .bars li { display: grid; grid-template-columns: minmax(90px, 130px) 1fr; gap: 12px; align-items: center; font-size: 14px; }
  .bars__track { height: 12px; border-radius: 999px; background: var(--f-mint); }
  .bars__track span { display: block; height: 12px; border-radius: 999px; background: var(--f-forest); }
  .report__fix { border-radius: 16px; padding: 16px 20px; display: flex; gap: 12px; align-items: start; background: var(--f-lav); font-size: 14px; line-height: 1.5; }

  /* Who */
  .who { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; margin: 0; padding: 0; }
  .who li { border-radius: var(--f-radius); padding: 32px; display: flex; flex-direction: column; gap: 12px; min-height: 240px; }
  .who p { margin: 0; font-size: 15px; line-height: 1.55; }
  .who__n { font-size: 40px; font-weight: 600; line-height: 1; }
  .who__t { margin: 0; font-size: 22px; }

  /* FAQ */
  .faq { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 48px; }
  .faq details { border-top: 1px solid var(--f-line); }
  .faq details:last-child { border-bottom: 1px solid var(--f-line); }
  .faq summary { cursor: pointer; font: 600 18px/1.3 'Inter Variable', sans-serif; padding: 20px 0; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-weight: 400; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin: 0 0 20px; font-size: 16px; line-height: 1.6; color: var(--f-ink-2); }

  /* CTA */
  .cta { background: var(--f-lime); border-radius: var(--f-radius); padding: clamp(32px, 5vw, 64px) clamp(20px, 4vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 40px; align-items: center; }
  .cta__label { font-weight: 600; font-size: 15px; }
  :global(.findable) .cta__in { flex: 1 1 240px; width: auto; border-radius: 999px; border-color: var(--f-ink); padding-inline: 20px; }
  .cta__note { font-size: 14px; }
</style>
