---
import Base from '../../layouts/Base.astro';
---
<Base title="Thanks" description="Your interest in the Findable pilot has been registered." noindex>
  <section class="wrap thanks">
    <p class="eyebrow" style="--dot: var(--green)">Registered</p>
    <h1 class="h-xl">Thanks. You’re on the list.</h1>
    <p class="lede">We’ll be in touch by email to talk about the Findable pilot and whether it’s a good fit for your business.</p>
    <div class="btn-row"><a class="btn btn--accent" href="/findable/">Back to Findable</a><a class="btn btn--ghost" href="/">Outside In home</a></div>
  </section>
</Base>
<style>.thanks { display: grid; gap: 1.5rem; justify-items: start; padding-block: var(--section); }</style>
