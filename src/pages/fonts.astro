---
/**
 * FONT TRIAL (temporary). Side-by-side type options for Ani, shown in the cleaner
 * colour-block format she referenced. Not linked, not indexed, not in the sitemap.
 * Delete this page and src/styles/font-trial.css once a font is chosen.
 */
import Base from '../layouts/Base.astro';

const options = [
  { id: 'current', name: 'Current: Bricolage Grotesque + Instrument Sans', note: 'Characterful, slightly quirky display face.', bg: 'var(--white)' },
  { id: 'host', name: 'Host Grotesk', note: 'Clean, neutral grotesk, close to the Studio Rippl and Social Club references. One family for everything.', bg: 'var(--green)' },
  { id: 'geist', name: 'Geist', note: 'Crisp and modern, a little more technical. Suits the AI side of the studio.', bg: 'var(--pink)' },
  { id: 'inter', name: 'Inter Tight + Inter', note: 'Very clean and familiar. It’s also Findable’s font, so the two brands would look closer.', bg: 'var(--purple)' },
  { id: 'archivo', name: 'Archivo (bold, wide, capitals) + Instrument Sans', note: 'Loud and punchy, like the “Be the brand they copy” reference.', bg: 'var(--red)' },
];
---
<Base title="Font options" description="Type options for the Outside In site." noindex>
  <section class="wrap intro">
    <p class="mono">[ Font options · preview only ]</p>
    <h1 class="intro__t">Which type feels like Outside In?</h1>
    <p class="intro__p">Each block uses the same words in a different typeface. To see the whole site in one, use the link under it: it stays on as you click around this preview tab.</p>
  </section>

  {options.map((o) => (
    <section class={`spec spec--${o.id}`} style={`--spec-bg: ${o.bg}`} aria-label={o.name}>
      <div class="wrap spec__in">
        <div class="spec__top">
          <p class="mono">[ {o.name} ]</p>
          <p class="mono spec__note">{o.note}</p>
        </div>
        <p class="spec__big">We see your business from the outside, then build what it needs on the inside.</p>
        <div class="spec__row">
          <p class="mono">[ About the studio ]</p>
          <div class="spec__body">
            <p>Outside In is a creative, marketing and AI studio in Aotearoa New Zealand. One team for brand, marketing and practical AI, across tourism, events and sport.</p>
            <a class="btn" href={`/?font=${o.id}`}>See the whole site in this font <span class="btn__arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .intro { padding-block: clamp(4rem, 9vw, 7rem) clamp(2rem, 5vw, 4rem); display: grid; gap: 1rem; }
  .intro__t { font-size: var(--step-4); max-width: 18ch; }
  .intro__p { color: var(--muted); max-width: 52ch; }

  .spec { background: var(--spec-bg); color: var(--ink); --fg: var(--ink); --muted: var(--ink); border-top: 1px solid var(--line); }
  .spec__in { padding-block: clamp(3rem, 7vw, 6rem); display: grid; gap: clamp(2rem, 5vw, 4rem); }
  .spec__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; border-bottom: 1px solid currentColor; padding-bottom: 1rem; }
  .spec__note { max-width: 40ch; text-transform: none; }
  .spec__big { font-family: var(--font-display); font-weight: 500; font-size: clamp(2.2rem, 1.2rem + 4vw, 5rem); line-height: 1.02; letter-spacing: -0.035em; max-width: 20ch; }
  .spec__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem var(--gutter); }
  .spec__body { display: grid; gap: 1.5rem; justify-items: start; font-family: var(--font-body); font-size: var(--step-1); line-height: 1.45; }
  @media (max-width: 760px) { .spec__row { grid-template-columns: 1fr; } }

  .spec--host { --font-display: 'Host Grotesk Variable', sans-serif; --font-body: 'Host Grotesk Variable', sans-serif; }
  .spec--geist { --font-display: 'Geist Variable', sans-serif; --font-body: 'Geist Variable', sans-serif; }
  .spec--inter { --font-display: 'Inter Tight Variable', sans-serif; --font-body: 'Inter Variable', sans-serif; }
  .spec--archivo { --font-display: 'Archivo Variable', sans-serif; }
  .spec--archivo .spec__big { font-weight: 800; font-stretch: 112%; text-transform: uppercase; letter-spacing: -0.01em; line-height: 0.95; }
</style>
