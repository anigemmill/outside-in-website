---
/**
 * HOMEPAGE v2 ("Showcase"). Build spec: docs/homepage-v2-spec.md.
 * Loud sections alternate with quieter ones, and only one effect animates on
 * screen at a time. Effects are switched on by src/scripts/home.ts; without
 * JavaScript or with reduced motion every section shows its finished state.
 *
 *  1 Hero (01 logo glide) · loud       7 How we think (07 colour strip) · medium
 *  2 Statement (02 wipe) · quiet       8 What we do (08 statements + trail) · quiet
 *  3 Work index (04 stack) · loud      9 Social (09 fan) · loud
 *  4 Featured (09 card fan) · medium     10 Call to action (10 corner squares) · medium
 *  5 How we work (05 drift) · loud    11 Footer (slim) · quiet
 *  6 Services (06 notched cards) · medium
 */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Note from '../components/Note.astro';
import WipeHeading from '../components/home/WipeHeading.astro';
import WorkStack from '../components/home/WorkStack.astro';
import FeaturedFan from '../components/home/FeaturedFan.astro';
import Drift from '../components/home/Drift.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import BeliefStrip from '../components/home/BeliefStrip.astro';
import Statements from '../components/home/Statements.astro';
import SocialFan from '../components/home/SocialFan.astro';
import CtaCard from '../components/home/CtaCard.astro';
import FindableFeature from '../components/FindableFeature.astro';
import { home } from '../data/home';
import { site } from '../config/site';
---
<Base description={site.seo.defaultDescription} home slimFooter>

  <!-- 1. The logo. As the hero scrolls away it glides into the header. -->
  <section class="hero" data-logo-zone data-hero data-pair="0" aria-labelledby="hero-title">
    <h1 id="hero-title" class="visually-hidden">Outside In: {home.hero.descriptor}</h1>
    <div class="hero__mark" data-glide-mark>
      <div class="hero__glide scrub" data-glide>
        <div class="hero__glide-move scrub">
          <Logo id="oi-hero" animate="load" interactive decorative class="hero__logo scrub" />
        </div>
      </div>
    </div>
    <p class="hero__line scrub" aria-hidden="true">{home.hero.descriptor}</p>
  </section>

  <!-- 2. One sentence -->
  <section id="intro" class="intro wrap" aria-labelledby="intro-title">
    <WipeHeading id="intro-title" class="intro__statement" text={home.intro.statement} colour="red" />
    <p class="intro__lede">
      {home.intro.lede} <a class="text-link" href="/contact/">Start a conversation <span aria-hidden="true">→</span></a>
    </p>
    <Note>The hero carries no text but the name. This line does the work: what we do and why it matters, then one way to act on it.</Note>
  </section>

  <!-- 3. Work index: the project stack -->
  <WorkStack />

  <!-- 4. Featured work: a fan of project cards -->
  <FeaturedFan />

  <!-- 4b. Our own product (quiet, between two effect sections) -->
  <section class="product wrap" aria-label="Findable, our product">
    <FindableFeature />
    <Note>One product, shown once. Findable is the studio’s AI and marketing thinking made into something operators can use every week.</Note>
  </section>

  <!-- 5. How we work: the drift field -->
  <Drift />

  <!-- 6. Services: notched cards -->
  <ServiceCards />

  <!-- 7. How we think: colour card strip (hidden until the statements are written) -->
  {home.beliefs.show && <BeliefStrip />}

  <!-- 8. What we do: line-by-line statements and the tag trail -->
  <Statements />

  <!-- 9. Social fan (hidden until real posts are supplied) -->
  {home.social.show && <SocialFan />}

  <!-- 10. Call to action -->
  <CtaCard />
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  /* Hero: the mark and one line, cycling through four colour pairs in time with the logo's blink. */
  .hero[data-pair='0'] { --hero-bg: var(--red);    --hero-fg: var(--green); }
  .hero[data-pair='1'] { --hero-bg: var(--pink);   --hero-fg: var(--red); }
  .hero[data-pair='2'] { --hero-bg: var(--purple); --hero-fg: var(--pink); }
  .hero[data-pair='3'] { --hero-bg: var(--green);  --hero-fg: var(--purple); }
  .hero {
    background: var(--hero-bg); color: var(--hero-fg);
    transition: background-color 0.06s linear, color 0.06s linear;
    min-height: 100svh; display: grid; place-items: center; align-content: center; gap: clamp(2rem, 4vw, 3.5rem);
    padding: 7rem var(--gutter) 5rem;
  }
  .hero__mark { width: min(56vw, 640px); cursor: ew-resize; touch-action: pan-y; }
  :global(.hero__logo) { width: 100%; color: inherit; }
  .hero__line { font-size: var(--step-0); font-weight: 500; color: var(--ink); text-align: center; letter-spacing: 0.01em; }
  @media (max-width: 640px) { .hero__mark { width: 78vw; } .hero__line { max-width: 22ch; } }

  /* 01 Logo glide. src/scripts/home.ts measures the route and sets --g-*. The logo
     sits above the header while it travels, then hands off to the header logo. */
  :global(.is-home) { timeline-scope: --hero; }
  .hero { view-timeline: --hero block; }
  :global(.glide-live) .hero { --tl: --hero; --range: cover var(--g-r0, 50%) cover var(--g-r1, 80%); }
  :global(.glide-live) .hero__glide { position: relative; z-index: 60; animation-name: glide-comp; }
  :global(.glide-live) .hero__glide-move { transform-origin: 0 0; animation-name: glide-move; }
  :global(.glide-live) :global(.hero__logo) { animation-name: glide-logo; }
  :global(.glide-live) .hero__line { animation-name: glide-line; }
  /* Keeps the logo still on screen while the hero scrolls; hides it at the hand-off. */
  @keyframes glide-comp {
    0% { transform: translateY(0px); opacity: 1; }
    99.9% { opacity: 1; }
    100% { transform: translateY(var(--g-comp, 0px)); opacity: 0; }
  }
  /* Straight line to the header slot, eased in-out, shrinking to the header size. */
  @keyframes glide-move {
    0% { transform: translate(0px, 0px) scale(1); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    100% { transform: translate(var(--g-dx, 0px), var(--g-dy, 0px)) scale(var(--g-s, 1)); }
  }
  /* Slices close over 0–70%; colour shifts to the header logo's colour over 80–100%.
     The colour is mixed through --glide-ink rather than animated directly, so the
     hero's colour cycle keeps control of the logo colour until the glide starts. */
  @property --glide-ink { syntax: '<number>'; inherits: true; initial-value: 0; }
  :global(.glide-live) :global(.hero__logo) { color: color-mix(in srgb, var(--brand-color) calc(var(--glide-ink) * 100%), var(--hero-fg)); }
  @keyframes glide-logo {
    0% { --oi-close: 0; --glide-ink: 0; }
    70% { --oi-close: 1; }
    80% { --glide-ink: 0; }
    100% { --oi-close: 1; --glide-ink: 1; }
  }
  @keyframes glide-line { 0% { opacity: 1; } 30%, 100% { opacity: 0; } }

  /* Findable */
  .product { padding-bottom: clamp(6rem, 12vw, 12rem); }

  /* Intro */
  .intro { padding-block: clamp(6rem, 14vw, 14rem); display: grid; gap: 2rem; }
  :global(.intro__statement) { font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4.8rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.03em; max-width: 20ch; }
  .intro__lede { font-size: var(--step-1); color: var(--muted); }
  .intro__lede .text-link { margin-left: 0.3em; white-space: nowrap; }

  /* Section heads, shared by the section components */
  :global(.row-head) { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  :global(.row-head__title) { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; }
</style>
