---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Note from '../components/Note.astro';
import FindableFeature from '../components/FindableFeature.astro';
import { services } from '../data/services';
import { home } from '../data/home';
import { getWork } from '../data/work';
import { site } from '../config/site';

// Featured projects, client work first. Falls back to the first published projects.
const published = await getWork();
const featured = (published.some((p) => p.data.featured) ? published.filter((p) => p.data.featured) : published).slice(0, 2);
---
<Base description={site.seo.defaultDescription} home>

  <!-- 1. The logo, and nothing else -->
  <section class="hero" data-logo-zone data-hero data-pair="0" aria-labelledby="hero-title">
    <h1 id="hero-title" class="visually-hidden">Outside In: {home.hero.descriptor}</h1>
    <div class="hero__mark">
      <Logo id="oi-hero" animate="load" interactive decorative class="hero__logo" />
    </div>
    <p class="hero__line" aria-hidden="true">{home.hero.descriptor}</p>
  </section>

  <!-- 2. One sentence -->
  <section id="intro" class="intro wrap" aria-labelledby="intro-title">
    <h2 id="intro-title" class="intro__statement" data-reveal>{home.intro.statement}</h2>
    <p class="intro__lede" data-reveal style="--reveal-delay:.08s">
      {home.intro.lede} <a class="text-link" href="/contact/">Start a conversation <span aria-hidden="true">→</span></a>
    </p>
    <Note>The hero carries no text but the name. This line does the work: what we do and why it matters, then one way to act on it.</Note>
  </section>

  <!-- 3. Two pieces of work, large -->
  <section class="work wrap" aria-labelledby="work-title">
    <div class="row-head">
      <h2 id="work-title" class="row-head__title">{home.work.title}</h2>
      <a class="text-link" href="/projects/">All projects <span aria-hidden="true">→</span></a>
    </div>
    <ul role="list" class="work__grid">
      {featured.map((p, i) => (
        <li data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <a href={`/projects/${p.id}/`} class="work__item">
            <div class="work__media" style={`view-transition-name: cover-${p.id}`}>
              <Image src={p.data.cover} alt="" loading="lazy" class="work__img" />
            </div>
            <div class="work__meta">
              <h3 class="work__title">{p.data.title}</h3>
              <p class="work__type">{p.data.status === 'concept' ? 'Concept · ' : ''}{p.data.type}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="work__note">{home.work.note}</p>
  </section>

  <!-- 4. Our own product -->
  <section class="product wrap" aria-label="Findable, our product">
    <FindableFeature />
    <Note>One product, shown once. Findable is the studio’s AI and marketing thinking made into something operators can use every week.</Note>
  </section>

  <!-- 5. Three services, one line each -->
  <section class="svc wrap" aria-labelledby="svc-title">
    <div class="row-head">
      <h2 id="svc-title" class="row-head__title">{home.services.title}</h2>
      <a class="text-link" href="/services/">All services <span aria-hidden="true">→</span></a>
    </div>
    <ol role="list" class="svc__grid">
      {services.map((s, i) => (
        <li class={`svc__item svc__item--${s.id}`} data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <a href={`/services/#${s.id}`}>
            <span class="svc__dot" aria-hidden="true"></span>
            <h3 class="svc__name">{s.name}</h3>
            <p class="svc__short">{s.short}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  /* Hero: white, the mark, one line */
  /* The hero cycles through four colour pairs (background / mark), in time with the logo's blink. */
  .hero[data-pair='0'] { --hero-bg: var(--red);    --hero-fg: var(--green); }
  .hero[data-pair='1'] { --hero-bg: var(--pink);   --hero-fg: var(--red); }
  .hero[data-pair='2'] { --hero-bg: var(--purple); --hero-fg: var(--pink); }
  .hero[data-pair='3'] { --hero-bg: var(--green);  --hero-fg: var(--purple); }
  .hero {
    background: var(--hero-bg); color: var(--hero-fg);
    transition: background-color 0.06s linear, color 0.06s linear;
    min-height: 100svh; display: grid; place-items: center; align-content: center; gap: clamp(2rem, 4vw, 3.5rem);
    padding: 7rem var(--gutter) 5rem;
  }
  .hero__mark { width: min(56vw, 640px); cursor: ew-resize; touch-action: pan-y; }
  :global(.hero__logo) { width: 100%; color: inherit; }
  .hero__line { font-size: var(--step-0); font-weight: 500; color: var(--ink); text-align: center; letter-spacing: 0.01em; }
  @media (max-width: 640px) { .hero__mark { width: 78vw; } .hero__line { max-width: 22ch; } }

  /* Intro */
  .intro { padding-block: clamp(6rem, 14vw, 14rem); display: grid; gap: 2rem; }
  .intro__statement { font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4.8rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.03em; max-width: 20ch; }
  .intro__lede { font-size: var(--step-1); color: var(--muted); }
  .intro__lede .text-link { margin-left: 0.3em; white-space: nowrap; }

  /* Section heads */
  .row-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .row-head__title { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; }

  /* Work */
  .work { padding-bottom: clamp(6rem, 12vw, 12rem); }
  .work__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); padding: 0; }
  .work__item { display: grid; gap: 1.1rem; text-decoration: none; color: var(--fg); }
  .work__media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--surface); }
  .work__img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .work__item:hover .work__img, .work__item:focus-visible .work__img { transform: scale(1.04); }
  .work__meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .work__title { font-size: var(--step-1); font-weight: 600; }
  .work__item:hover .work__title { color: var(--link); }
  .work__type { color: var(--muted); font-size: var(--step--1); }
  .work__note { margin-top: 2rem; color: var(--muted); font-size: var(--step--1); }
  @media (max-width: 760px) { .work__grid { grid-template-columns: 1fr; } }

  /* Findable */
  .product { padding-bottom: clamp(6rem, 12vw, 12rem); }

  /* Services */
  .svc { padding-bottom: clamp(6rem, 12vw, 12rem); }
  .svc__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); padding: 0; }
  .svc__item a { display: grid; gap: 0.8rem; padding-top: 1.5rem; border-top: 1px solid var(--line); text-decoration: none; color: var(--fg); transition: border-color 0.3s; }
  .svc__dot { width: 1rem; height: 1rem; border-radius: 50%; background: var(--dot); box-shadow: 0 0 0 1.5px var(--ink); }
  .svc__item--design-creative { --dot: var(--pink); }
  .svc__item--marketing-growth { --dot: var(--green); }
  .svc__item--ai-systems { --dot: var(--purple); }
  .svc__item a:hover { border-color: var(--dot); }
  .svc__name { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; }
  .svc__item a:hover .svc__name { color: var(--link); }
  .svc__short { color: var(--muted); max-width: 32ch; }
  @media (max-width: 860px) { .svc__grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
