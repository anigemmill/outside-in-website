---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Note from '../components/Note.astro';
import BookingLink from '../components/BookingLink.astro';
import Badge from '../components/Badge.astro';
import { services } from '../data/services';
import { home } from '../data/home';
import { site } from '../config/site';

const featured = (await getCollection('work', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const tones = ['blush', 'lime', 'lilac', 'magenta'];
---
<Base description={site.seo.defaultDescription} home>

  <!-- 1. HERO: the logo animation, nothing else ------------------------- -->
  <section class="hero" data-logo-zone data-hero aria-labelledby="hero-title">
    <h1 id="hero-title" class="visually-hidden">Outside In: {home.hero.descriptor}</h1>
    <div class="hero__mark">
      <Logo id="oi-hero" animate="load" interactive decorative class="hero__logo" />
    </div>
    <p class="hero__label hero__label--centre" aria-hidden="true">{home.hero.descriptor}</p>
    <p class="hero__label hero__label--left">{home.hero.location}</p>
    <a class="hero__label hero__label--right" href="#intro">Scroll <span aria-hidden="true">↓</span></a>
    <Badge class="hero__badge" />
  </section>

  <!-- 2. ONE STATEMENT --------------------------------------------------- -->
  <section id="intro" class="intro wrap" aria-labelledby="intro-title">
    <h2 id="intro-title" class="intro__statement" data-reveal>{home.intro.statement}</h2>
    <div class="intro__side" data-reveal style="--reveal-delay:.1s">
      <p class="lede">{home.intro.lede}</p>
      <div class="btn-row">
        <BookingLink />
        <a class="btn btn--ghost" href="/about/">About us</a>
      </div>
    </div>
    <Note>The hero says nothing but the name, so this line does all the work: what we do and why it matters, in one sentence, then two clear next steps.</Note>
  </section>

  <!-- 3. WORK: portrait cards ------------------------------------------ -->
  <section class="work wrap" aria-labelledby="work-title">
    <div class="row-head">
      <h2 id="work-title" class="row-head__title">{home.work.title}</h2>
      <a class="btn btn--ghost" href="/work/">All projects <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
    <ul role="list" class="tiles">
      {featured.map((p, i) => (
        <li class={`tile tile--${tones[i % tones.length]}`} data-reveal style={`--reveal-delay:${i * 0.07}s`}>
          <a href={`/work/${p.id}/`} class="tile__link">
            <div class="tile__media" style={`view-transition-name: cover-${p.id}`}>
              <Image src={p.data.cover} alt="" loading="lazy" class="tile__img" />
            </div>
            <div class="tile__body">
              <span class="tag tag--concept">{p.data.status === 'concept' ? 'Concept' : 'Client work'}</span>
              <h3 class="tile__title">{p.data.title}</h3>
              <p class="tile__sum">{p.data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="work__note mono">{home.work.note}</p>
  </section>

  <!-- 4. SERVICES: numbered list --------------------------------------- -->
  <section class="svc-list wrap" aria-labelledby="svc-title">
    <div class="row-head">
      <h2 id="svc-title" class="row-head__title">{home.services.title}</h2>
      <a class="btn btn--ghost" href="/services/">All services <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
    <ol role="list" class="svc-rows">
      {services.map((s) => (
        <li class={`svc-row svc-row--${s.id}`} data-reveal>
          <a href={`/services/#${s.id}`} class="svc-row__link">
            <span class="svc-row__n mono">{s.number}</span>
            <span class="svc-row__name">{s.name}</span>
            <span class="svc-row__short">{s.short}</span>
            <span class="svc-row__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="svc-list__note">{home.services.partnership}</p>
  </section>
</Base>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    position: relative; min-height: 100svh; display: grid; place-items: center;
    background: var(--moss); color: var(--blush);
    padding: 6rem var(--gutter) 5rem; overflow: hidden;
  }
  :root[data-view='inside'] .hero { background: var(--ink); color: var(--lime); }
  .hero__mark { width: min(78vw, 980px); cursor: ew-resize; touch-action: pan-y; }
  :global(.hero__logo) { width: 100%; }
  .hero__label {
    position: absolute; bottom: 1.6rem; margin: 0;
    font-family: var(--font-mono); font-size: clamp(0.8rem, 0.7rem + 0.4vw, 1.05rem); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--cream); text-decoration: none;
  }
  .hero__label--left, .hero__label--right { background: var(--cream); color: var(--ink); padding: 0.55rem 1rem; border-radius: var(--pill); font-size: 0.8rem; }
  .hero__label--left { left: var(--gutter); }
  .hero__label--right { right: var(--gutter); transition: background-color 0.25s; }
  .hero__label--right:hover, .hero__label--right:focus-visible { background: var(--blush); }
  .hero__label--centre {
    position: absolute; bottom: auto; top: calc(50% + min(26vw, 330px)); left: 50%; transform: translateX(-50%);
    font-size: clamp(1.2rem, 0.8rem + 1vw, 1.7rem); font-weight: 700; letter-spacing: 0.1em; white-space: nowrap; color: var(--cream);
  }
  :global(.hero__badge) { position: absolute; top: clamp(5.5rem, 10vw, 8rem); right: clamp(1rem, 5vw, 5rem); }
  @media (max-width: 640px) {
    .hero__mark { width: 86vw; }
    .hero__label--centre { white-space: normal; text-align: center; width: 84vw; top: calc(50% + 31vw); font-size: 1.2rem; }
    .hero__label--left { display: none; }
  }

  /* Intro statement ------------------------------------------------------ */
  .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--gutter); align-items: end; padding-block: var(--section); }
  .intro__statement { font-size: clamp(2.4rem, 1.4rem + 4.4vw, 6rem); line-height: 0.98; letter-spacing: -0.035em; max-width: 16ch; }
  .intro__side { display: grid; gap: 1.5rem; }
  @media (max-width: 860px) { .intro { grid-template-columns: 1fr; } }

  /* Row heads -------------------------------------------------------------- */
  .row-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; padding-bottom: 1.25rem; margin-bottom: 2rem; border-bottom: 2px solid var(--fg); }
  .row-head__title { font-size: var(--step-4); letter-spacing: -0.035em; text-transform: uppercase; }

  /* Work tiles (portrait) -------------------------------------------------- */
  .work { padding-bottom: var(--section); }
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); padding: 0; }
  .tile__link { display: grid; text-decoration: none; color: var(--ink); border-radius: var(--radius); overflow: hidden; height: 100%; background: var(--tone); transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out); }
  .tile--blush { --tone: var(--blush); } .tile--lime { --tone: var(--lime); } .tile--lilac { --tone: var(--lilac); } .tile--magenta { --tone: var(--magenta); }
  .tile__link:hover, .tile__link:focus-visible { transform: translateY(-6px) rotate(-1deg); box-shadow: 0 18px 0 -6px var(--ink); }
  .tile__media { aspect-ratio: 4 / 5; overflow: hidden; }
  .tile__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease-out); }
  .tile__link:hover .tile__img { transform: scale(1.05); }
  .tile__body { display: grid; gap: 0.5rem; justify-items: start; padding: 1.1rem 1.1rem 1.4rem; align-content: start; }
  .tile__title { font-size: var(--step-2); text-transform: uppercase; letter-spacing: -0.02em; }
  .tile__sum { font-size: var(--step--1); }
  .work__note { margin-top: 1.5rem; color: var(--muted); max-width: 70ch; }
  @media (max-width: 1100px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .tiles { grid-template-columns: 1fr; } }

  /* Services list ---------------------------------------------------------- */
  .svc-list { padding-bottom: var(--section); }
  .svc-rows { padding: 0; border-top: 0; }
  .svc-row { border-bottom: 2px solid var(--fg); }
  .svc-row__link {
    display: grid; grid-template-columns: 4rem minmax(0, 1.1fr) minmax(0, 1fr) 3rem; gap: 1rem var(--gutter); align-items: center;
    padding: clamp(1.2rem, 2.5vw, 2.2rem) 1rem; text-decoration: none; color: var(--fg);
    transition: background-color 0.35s var(--ease-out), padding 0.35s var(--ease-out);
  }
  .svc-row__n { font-size: 1rem; }
  .svc-row__name { font-family: var(--font-display); font-weight: 800; font-size: var(--step-4); letter-spacing: -0.035em; line-height: 0.95; text-transform: uppercase; }
  .svc-row__short { color: var(--muted); }
  .svc-row__arrow { font-size: var(--step-2); justify-self: end; transition: transform 0.35s var(--ease-out-back); }
  .svc-row__link:hover, .svc-row__link:focus-visible { padding-left: 1.75rem; color: var(--ink); --muted: var(--ink-soft); }
  .svc-row--design-creative .svc-row__link:hover, .svc-row--design-creative .svc-row__link:focus-visible { background: var(--blush); }
  .svc-row--marketing-growth .svc-row__link:hover, .svc-row--marketing-growth .svc-row__link:focus-visible { background: var(--lime); }
  .svc-row--ai-systems .svc-row__link:hover, .svc-row--ai-systems .svc-row__link:focus-visible { background: var(--lilac); }
  .svc-row__link:hover .svc-row__arrow { transform: translateX(6px); }
  .svc-list__note { margin-top: 1.5rem; font-size: var(--step-1); max-width: 50ch; }
  @media (max-width: 760px) {
    .svc-row__link { grid-template-columns: 2rem minmax(0, 1fr) 1.5rem; gap: 0.5rem 0.75rem; padding-inline: 0.25rem; }
    .svc-row__link:hover, .svc-row__link:focus-visible { padding-left: 0.75rem; }
    .svc-row__name { font-size: clamp(1.6rem, 8.4vw, 2.6rem); }
    .svc-row__short { grid-column: 2; grid-row: 2; }
    .svc-row__arrow { grid-column: 3; grid-row: 1; }
  }
</style>
