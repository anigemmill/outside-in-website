---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Note from '../../components/Note.astro';
import FindableFeature from '../../components/FindableFeature.astro';
import { services } from '../../data/services';
import { getWork } from '../../data/work';

const projects = await getWork();
const conceptCount = projects.filter((p) => p.data.status === 'concept').length;
const filters = [
  { id: 'all', label: 'All' },
  ...services.map((s) => ({ id: s.id, label: s.name })),
  { id: 'client', label: 'Selected work' },
];
---
<Base
  title="Projects"
  description="Selected brand, digital and marketing work by Ani Gemmill of Outside In, across tourism, events and sport, plus two clearly labelled AI concept projects."
>
  <PageHero
    eyebrow="Projects"
    dot="red"
    title="Ideas, built."
    lede="Brand, digital and marketing work across tourism, events and sport: identities, campaigns, destination apps and the digital journeys behind them."
  />

  <section class="wrap product" aria-label="Our product">
    <FindableFeature />
    <Note>Findable is Outside In’s own product, so it sits above the selected work and concepts rather than in the grid.</Note>
  </section>

  <section class="wrap work-index" aria-label="Projects">
    <div class="work-index__bar">
      <div class="filters" role="group" aria-label="Filter projects" data-filters hidden>
        {filters.map((f, i) => (
          <button type="button" class="filter" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>
      {conceptCount > 0 && (
        <p class="disclosure">Projects marked Concept are self-initiated AI proof-of-concept work, not client commissions. They show how we’d approach a real brief and claim no results.</p>
      )}
    </div>
    <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    <Note>Filters use the same three disciplines as the Services page, so someone looking for AI work finds it in one click.</Note>

    <div class="grid-work" data-work-grid>
      {projects.map((p, i) => <ProjectCard project={p} headingLevel="h2" priority={i < 2} />)}
    </div>

    <div class="empty" data-empty hidden>
      <p class="empty__title">Nothing here yet.</p>
      <p class="empty__text" data-empty-text>No projects match this filter.</p>
      <button type="button" class="btn btn--ghost" data-filter-reset>Show all projects</button>
    </div>
  </section>
</Base>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-work-grid] .tile')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const emptyText = document.querySelector<HTMLElement>('[data-empty-text]')!;
  const status = document.querySelector<HTMLElement>('[data-filter-status]')!;
  if (wrap) {
    wrap.hidden = false;
    const buttons = [...wrap.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const apply = (id: string) => {
      let shown = 0;
      cards.forEach((c) => {
        const cats = (c.dataset.categories ?? '').split(' ');
        const isClient = c.dataset.status === 'client';
        const match = id === 'all' || (id === 'client' ? isClient : cats.includes(id));
        c.hidden = !match;
        if (match) { shown++; c.classList.add('is-in'); }
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === id)));
      empty.hidden = shown > 0;
      emptyText.textContent = id === 'client'
        ? 'Client projects appear here once they’re approved for publication. In the meantime, the concepts show how we work.'
        : 'No projects match this filter yet.';
      const label = buttons.find((b) => b.dataset.filter === id)?.textContent ?? '';
      status.textContent = `${shown} project${shown === 1 ? '' : 's'} shown${id === 'all' ? '' : ` for ${label}`}.`;
      const url = new URL(location.href);
      if (id === 'all') url.searchParams.delete('filter'); else url.searchParams.set('filter', id);
      history.replaceState(null, '', url);
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
    document.querySelector('[data-filter-reset]')?.addEventListener('click', () => apply('all'));
    const initial = new URL(location.href).searchParams.get('filter');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
  }
</script>

<style>
  .product { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .work-index { padding-bottom: clamp(6rem, 12vw, 12rem); }
  .work-index__bar { display: grid; gap: 1.25rem; padding-bottom: 1.5rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--line); }
  .filters { display: flex; flex-wrap: wrap; gap: 0.25rem 1.75rem; }
  .filters[hidden] { display: none; }
  .filter {
    min-height: 44px; padding: 0; border: 0; background: none; color: var(--muted);
    font-size: var(--step-0); font-weight: 500; position: relative;
  }
  .filter::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.45rem; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease-out); }
  .filter:hover { color: var(--fg); }
  .filter[aria-pressed='true'] { color: var(--fg); }
  .filter[aria-pressed='true']::after, .filter:hover::after { transform: scaleX(1); }
  .disclosure { color: var(--muted); font-size: var(--step--1); max-width: 70ch; }
  .grid-work { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(3.5rem, 7vw, 6rem) clamp(1.5rem, 3vw, 3rem); }
  .grid-work > :global(.tile[hidden]) { display: none; }
  .empty { display: grid; gap: 1rem; justify-items: start; padding: 3rem 0; }
  .empty[hidden] { display: none; }
  .empty__title { font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; }
  .empty__text { color: var(--muted); max-width: 52ch; }
  @media (max-width: 760px) { .grid-work { grid-template-columns: 1fr; } }
</style>
