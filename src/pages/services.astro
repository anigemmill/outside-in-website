---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Note from '../components/Note.astro';
import BookingLink from '../components/BookingLink.astro';
import { services, combinations, partnership } from '../data/services';

// One colour per discipline, taken from the hero pairs.
const colour: Record<string, string> = { 'design-creative': 'pink', 'marketing-growth': 'green', 'ai-systems': 'purple' };
---
<Base
  title="Services"
  description="Design and creative, marketing and growth, and practical AI strategy and implementation. Individual projects or an ongoing partnership, from one New Zealand team."
>
  <PageHero
    eyebrow="Services"
    dot="pink"
    title="Three disciplines, built to work together."
    lede="Hire us for one thing or all three. Either way, you get people who understand how a brand, a campaign and the systems behind them affect each other."
  >
    <nav class="jump" aria-label="Services on this page">
      {services.map((s) => <a href={`#${s.id}`}><span class="jump__dot" style={`--c: var(--${colour[s.id]})`}></span>{s.name}</a>)}
      <a href="#together">Working together</a>
    </nav>
  </PageHero>

  <div class="wrap svc-list">
    {services.map((s) => (
      <section id={s.id} class="svc" aria-labelledby={`${s.id}-title`}>
        <div class="svc__side" data-reveal>
          <div class="svc__swatch" style={`--c: var(--${colour[s.id]})`} aria-hidden="true">{s.number}</div>
          <p class="svc__layer">{s.layer}</p>
          <h2 id={`${s.id}-title`} class="svc__name">{s.name}</h2>
          <p class="svc__lead">{s.lead}</p>
        </div>
        <div class="svc__detail">
          <div class="svc__group" data-reveal>
            <h3 class="svc__h">Problems it solves</h3>
            <ul role="list" class="svc__problems">{s.problems.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div class="svc__group" data-reveal>
            <h3 class="svc__h">What’s included</h3>
            <ul role="list" class="svc__included">{s.includes.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div class="svc__group" data-reveal>
            <h3 class="svc__h">What you can expect</h3>
            <ul role="list" class="svc__expect">{s.outcomes.map((p) => <li>{p}</li>)}</ul>
          </div>
          {s.id === 'ai-systems' && (
            <Note>AI gets the most detail because buyers are least sure what it means in practice. Every item is concrete and checkable, with no promised percentages we can’t yet evidence.</Note>
          )}
        </div>
      </section>
    ))}
  </div>

  <section id="together" class="wrap together" aria-labelledby="together-title">
    <div class="together__head">
      <h2 id="together-title" class="together__title">Working together</h2>
      <p class="muted">Most briefs touch more than one discipline. These are common shapes an engagement takes. Each one is scoped to the problem, so treat them as starting points, not packages.</p>
    </div>
    <ul role="list" class="combos">
      {combinations.map((c, i) => (
        <li data-reveal style={`--reveal-delay:${i * 0.06}s`}>
          <h3 class="combo__name">{c.name}</h3>
          <p class="muted">{c.for}</p>
          <p class="combo__mix">{c.mix.join(' · ')}</p>
        </li>
      ))}
    </ul>

    <div class="partner" data-reveal>
      <div>
        <h3 class="combo__name">{partnership.name}</h3>
        <p class="muted">{partnership.lead}</p>
      </div>
      <ul role="list" class="svc__expect">{partnership.points.map((p) => <li>{p}</li>)}</ul>
    </div>

    <div class="pricing">
      <div>
        <h3 class="combo__name">What does it cost?</h3>
        <p class="muted">It depends on the scope, so we don’t publish prices. After a discovery call you’ll get a written proposal setting out the scope, timeline and cost.</p>
      </div>
      <BookingLink />
    </div>
    <Note>Pricing is answered honestly up front. Visitors who look for prices and find nothing tend to leave; telling them how pricing works keeps them moving toward a call.</Note>
  </section>
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; margin-top: 0.5rem; }
  .jump a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; color: var(--fg); text-decoration: none; font-weight: 500; }
  .jump a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .jump__dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 1.5px var(--ink); }

  .svc-list { padding-bottom: clamp(3rem, 6vw, 5rem); }
  .svc {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem var(--gutter);
    padding-block: clamp(4rem, 8vw, 7rem); border-top: 1px solid var(--line); scroll-margin-top: 5rem;
  }
  .svc__side { display: grid; gap: 1rem; align-content: start; justify-items: start; position: sticky; top: 7rem; align-self: start; }
  .svc__swatch {
    display: grid; place-items: end start; width: clamp(5rem, 9vw, 7rem); aspect-ratio: 1; padding: 0.7rem;
    background: var(--c); color: var(--ink); border-radius: var(--radius);
    font-family: var(--font-display); font-weight: 600; font-size: var(--step-1);
  }
  .svc__layer { color: var(--muted); font-size: var(--step--1); margin-top: 0.5rem; }
  .svc__name { font-size: var(--step-4); font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
  .svc__lead { font-size: var(--step-1); color: var(--muted); max-width: 30ch; line-height: 1.4; }
  .svc__detail { display: grid; gap: clamp(2.5rem, 4vw, 3.5rem); }
  .svc__h { font-family: var(--font-body); font-size: var(--step-0); font-weight: 600; letter-spacing: 0; margin-bottom: 1rem; }
  .svc__problems { display: grid; padding: 0; }
  .svc__problems li { font-family: var(--font-display); font-weight: 500; font-size: var(--step-2); line-height: 1.2; letter-spacing: -0.015em; padding-block: 0.7rem; border-bottom: 1px solid var(--line); }
  .svc__problems li:first-child { padding-top: 0; }
  .svc__included { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem var(--gutter); padding: 0; }
  .svc__expect { display: grid; gap: 0.6rem; padding: 0; }
  .svc__included li, .svc__expect li { position: relative; padding-left: 1.2rem; color: var(--fg); }
  .svc__included li::before, .svc__expect li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--muted); }
  @media (max-width: 860px) {
    .svc { grid-template-columns: 1fr; }
    .svc__side { position: static; }
    .svc__included { grid-template-columns: 1fr; }
  }

  .together { padding-block: clamp(4rem, 8vw, 7rem) clamp(6rem, 12vw, 12rem); border-top: 1px solid var(--line); }
  .together__head { display: grid; gap: 1rem; max-width: 52ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .together__title { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; }
  .combos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); padding: 0; }
  .combos li { display: grid; gap: 0.6rem; align-content: start; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .combo__name { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; }
  .combo__mix { font-size: var(--step--1); }
  .partner, .pricing { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem var(--gutter); align-items: start; margin-top: clamp(3rem, 6vw, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .partner > div, .pricing > div { display: grid; gap: 0.6rem; max-width: 44ch; }
  .pricing { align-items: end; }
  .pricing :global(.btn) { justify-self: start; }
  @media (max-width: 860px) { .combos, .partner, .pricing { grid-template-columns: 1fr; } }
</style>
