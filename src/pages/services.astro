---
/** Services (mockup: design/source/services.html). Copy unchanged from the mockup; pricing isn't published. */
import Base from '../layouts/Base.astro';

const disciplines = [
  {
    id: 'design-creative', n: '01', side: 'Outside', name: 'Design & Creative', dark: false,
    line: 'Make the first impression the right one, everywhere people meet you.',
    cols: [
      { h: 'Problems it solves', items: ['Your brand looks fine, and fine is forgettable.', 'Every touchpoint looks slightly different.', 'The website looks good but doesn’t turn visitors into enquiries.', 'An event is coming and the content plan is a blank page.'] },
      { h: 'What’s included', items: ['Brand identity, guidelines and templates', 'Website design and digital experiences', 'Campaign concepts and creative', 'Event branding and content creation', 'Print, signage and collateral'] },
      { h: 'What you can expect', items: ['A visual system your team can apply without calling us', 'A website designed around the one action you need visitors to take', 'Event content planned before the day and delivered while it still matters'] },
    ],
  },
  {
    id: 'marketing-growth', n: '02', side: 'Between', name: 'Marketing & Growth', dark: true,
    line: 'Get the right people to notice, and give them a reason to act.',
    cols: [
      { h: 'Problems it solves', items: ['Plenty of marketing activity, no clear goal behind it.', 'Content that fills a calendar but doesn’t move bookings.', 'Lots of data, very little insight.', 'A slow season you plan around every year instead of fixing.'] },
      { h: 'What’s included', items: ['Marketing and campaign strategy', 'Audience, market and competitor research', 'Content strategy and production', 'Social, search and paid channel planning', 'Visibility in search engines and AI answer tools', 'Performance reporting and optimisation'] },
      { h: 'What you can expect', items: ['A plan tied to a commercial goal, with the measure agreed up front', 'Campaigns built around what your audience actually cares about', 'Reporting that ends with a recommendation'] },
    ],
  },
  {
    id: 'ai-systems', n: '03', side: 'Inside', name: 'AI & Systems', dark: false,
    line: 'Practical AI: chosen for a reason, built into real workflows, owned by your team.',
    cols: [
      { h: 'Problems it solves', items: ['Your team is curious about AI, but nobody owns it.', 'Repetitive admin eats hours that should go to customers.', 'You have reports and data but no time to read them.', 'You’ve tried AI tools that nobody kept using.'] },
      { h: 'What’s included', items: ['AI opportunity audit and practical roadmap', 'AI agents for research, enquiries and internal knowledge', 'Workflow automation across the tools you already use', 'Marketing intelligence and automated reporting', 'Training, documentation and handover'] },
      { h: 'What you can expect', items: ['A ranked list of AI opportunities, with effort and value spelled out', 'Working automations in tools your team already uses', 'Time saved, measured against a baseline we agree at the start'] },
    ],
  },
];

const shapes = [
  { name: 'Launch', who: 'New businesses, products and rebrands', what: 'Brand identity · Website · Launch campaign · Automated enquiry handling' },
  { name: 'Grow', who: 'Established businesses wanting more from marketing', what: 'Campaign strategy · Content system · Channel plan · Weekly AI performance brief' },
  { name: 'Modernise', who: 'Teams buried in admin or unsure where AI fits', what: 'AI opportunity audit · Workflow automation · Team training · Refreshed touchpoints' },
  { name: 'Ongoing partnership', who: 'A standing creative, marketing and AI team, without hiring one', what: 'Monthly priorities · One point of contact · Work that builds on last month’s', featured: true },
];

const service = disciplines.map((d) => ({ '@type': 'Service', name: d.name, description: d.line, provider: { '@type': 'Organization', name: 'Outside In' }, areaServed: 'NZ' }));
---
<Base title="Services" footerCta description="Design & Creative, Marketing & Growth and AI & Systems from one studio. Hire Outside In for one discipline or all three." schema={service}>
  <header class="band on-blue sv-head">
    <div class="wrap sv-head__in">
      <p class="label sv-kicker">[ Services ]</p>
      <div class="sv-title-wrap">
        <h1 class="sv-title">Three disciplines, built to work <em class="em">together.</em></h1>
        <p class="sv-title sv-title--band" aria-hidden="true">Three disciplines, built to work <em class="em">together.</em></p>
      </div>
      <div class="sv-head__foot">
        <p class="sv-lede">Hire us for one thing or all three. Either way, you get people who understand how a brand, a campaign and the systems behind them affect each other.</p>
        <nav class="sv-jump" aria-label="Disciplines">
          {disciplines.map((d) => <a class="pill pill--outline" href={`#${d.id}`}>{d.name}</a>)}
        </nav>
      </div>
    </div>
  </header>

  {disciplines.map((d) => (
    <section id={d.id} class:list={['band', 'sv', { 'on-maroon': d.dark }]} aria-labelledby={`${d.id}-h`}>
      <div class="wrap sv__in">
        <div class="sv__head">
          <div class="sv__name"><span class="sv__n">[ {d.n} ] {d.side}</span><h2 id={`${d.id}-h`}>{d.name}</h2></div>
          <p class="sv__line">{d.line}</p>
        </div>
        <div class="sv__cols">
          {d.cols.map((col) => (
            <div class="sv__col">
              <h3 class="label label--strong">{col.h}</h3>
              <ul role="list">{col.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="band on-blue shapes" aria-labelledby="shapes-h">
    <div class="wrap shapes__in">
      <div class="shapes__head">
        <h2 id="shapes-h">Working together</h2>
        <p>Common shapes an engagement takes. Each is scoped to the problem — starting points, not packages.</p>
      </div>
      <ul role="list" class="shapes__grid">
        {shapes.map((s) => (
          <li class:list={['shape', { 'shape--featured on-maroon': s.featured }]}>
            <span class="shape__top"><span class="shape__name">{s.name}</span><span class="shape__who">{s.who}</span></span>
            <span class="shape__what">{s.what}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band cost" aria-labelledby="cost-h">
    <div class="wrap cost__in">
      <h2 id="cost-h" class="label">[ What does it cost? ]</h2>
      <p class="cost__text">It depends on the scope, so we don’t publish prices. After a discovery call you’ll get a written proposal with the scope, timeline and cost.</p>
    </div>
  </section>
</Base>

<style>
  .sv-head { overflow-x: clip; padding-bottom: clamp(48px, 5vw, 80px); }
  .sv-head__in { display: flex; flex-direction: column; gap: 40px; }
  .sv-kicker { color: var(--maroon); }
  /* The headline with a slice through it that slides back into place. */
  .sv-title-wrap { position: relative; }
  .sv-title { text-wrap: balance; font-weight: 500; font-size: clamp(52px, 7.4vw, 112px); line-height: 0.95; letter-spacing: -0.05em; max-width: 1100px; }
  .sv-title .em { letter-spacing: -0.02em; color: var(--orange); }
  .sv-title--band { position: absolute; inset: 0; margin: 0; background: var(--blue); clip-path: inset(36% 0 52% 0); animation: slice-in 1.1s var(--ease-back) 0.3s both; }
  @keyframes slice-in { 0%, 35% { transform: translateX(0.32em); } 100% { transform: translateX(0); } }
  .sv-head__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .sv-lede { font-size: 19px; line-height: 1.5; max-width: 560px; }
  .sv-jump { display: flex; flex-wrap: wrap; gap: 8px; }

  .sv { padding-block: clamp(56px, 6vw, 96px); }
  .sv__in { display: flex; flex-direction: column; gap: 48px; }
  .sv__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; border-bottom: 1px solid currentColor; padding-bottom: 24px; }
  .sv:not(.on-maroon) .sv__head { border-color: var(--brown); }
  .sv__name { display: flex; flex-direction: column; gap: 10px; }
  .sv__n { font-size: 13px; color: var(--maroon); }
  .on-maroon .sv__n { color: var(--pink); }
  .sv__name h2 { font-weight: 500; font-size: clamp(36px, 4vw, 56px); letter-spacing: -0.035em; }
  .sv__line { font-size: 18px; max-width: 420px; line-height: 1.45; }
  .sv__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 40px; font-size: 15px; line-height: 1.55; color: var(--brown-soft); }
  .on-maroon .sv__cols { color: var(--cream); }
  .sv__col { display: flex; flex-direction: column; gap: 14px; }
  .sv__col h3 { color: var(--brown); }
  .on-maroon .sv__col h3 { color: var(--pink); }
  .sv__col ul { display: flex; flex-direction: column; gap: 14px; }

  .shapes { padding-block: clamp(56px, 6vw, 96px); }
  .shapes__in { display: flex; flex-direction: column; gap: 40px; }
  .shapes__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .shapes__head h2 { font-weight: 500; font-size: clamp(36px, 4vw, 56px); letter-spacing: -0.035em; }
  .shapes__head p { font-size: 16px; max-width: 460px; line-height: 1.5; }
  .shapes__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .shape { background: var(--paper); padding: 24px; min-height: 260px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .shape__top { display: flex; flex-direction: column; gap: 6px; }
  .shape__name { font-size: 28px; letter-spacing: -0.02em; color: var(--orange); line-height: 1.1; }
  .shape__who { font-size: 14px; }
  .shape__what { font-size: 13px; line-height: 1.6; color: var(--brown-soft); }
  /* The partnership card: maroon, so its small text stays readable (cream on orange is large-text only). */
  .shape--featured { background: var(--maroon); }
  .shape--featured .shape__name { color: var(--pink); }
  .shape--featured .shape__who, .shape--featured .shape__what { color: var(--cream); }

  .cost { padding-block: clamp(56px, 6vw, 96px); }
  .cost__in { display: flex; flex-wrap: wrap; gap: 48px; }
  .cost__in h2 { flex: 1 1 240px; color: var(--maroon); }
  .cost__text { flex: 2 1 560px; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.25; letter-spacing: -0.015em; }
</style>
